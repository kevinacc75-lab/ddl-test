+// r33 tablet smoothness and caption placement (Claude, 23 Oct). SELF-VERIFIED (builder = verifier), NOT independent.
+// Kevy 22 Oct 23:29: "the animations at times can be janky not sure if it's just the tablet".
+// 1. r33-polish.css is loaded and offline-listed; on Balanced / Smooth (the automatic choice on touch screens) the route glow
+//    no longer animates its shadow, route dashes stop after a few loops, zone flares drop the brightness filter, and the
+//    page cannot drift sideways on phones.
+// 2. No forced layout in the duel update path: the shell reads the window size only on resize; captions and route glows
+//    restart their animations without reading offsetWidth.
+// 3. At most MAX_ROUTES route lines on screen at once.
+// 4. The combo-plan chip sits just below the opponent's revealed hand, not on it.
+import assert from 'node:assert/strict';import fs from 'node:fs';import {JSDOM} from 'jsdom';
+const css=fs.readFileSync('dist/r33-polish.css','utf8'),html=fs.readFileSync('dist/index.html','utf8'),offline=JSON.parse(fs.readFileSync('dist/offline-assets.json','utf8'));
+assert.ok(html.includes('href="./r33-polish.css"')&&html.includes('href="./deck-list.css"'),'stylesheets linked');
+for(const f of ['./r33-polish.css','./deck-list.css','./deck-list.mjs','./deck-cards.json'])assert.ok(offline.includes(f),f+' offline');
+assert.match(css,/html\{overflow-x:clip\}/);
+assert.match(css,/body:is\(\[data-graphics=balanced\],\[data-graphics=smooth\]\) :is\(\.lr-glow,\.lr-activate,\.lr-target\)\{animation:none!important\}/);
+assert.match(css,/\.lr-flow\{animation-iteration-count:4\}/);
+assert.match(css,/@keyframes fx23-zone-lite\{[^@]*\}/);assert.ok(!/fx23-zone-lite\{[^@]*filter/.test(css),'lite flare has no filter');
+assert.match(css,/animation-name:fx23-zone-lite!important/);
+const shell=fs.readFileSync('dist/app-shell.mjs','utf8'),resize=shell.slice(shell.indexOf('function resize('),shell.indexOf("window.addEventListener('resize'"));
+assert.ok(!/window\.inner(Width|Height)/.test(resize.replace("if(e?.type==='resize'){viewW=window.innerWidth;viewH=window.innerHeight}",'')),'resize() reads the window size only on a resize event');
+for(const f of ['dist/learning-captions.mjs','dist/learning-routes.mjs'])assert.ok(!/void [a-z]+\.offsetWidth/.test(fs.readFileSync(f,'utf8')),f+': no forced reflow');
+// 3. Route-line cap
+const dom=new JSDOM('<!doctype html><body><div id="layer"></div><div id="opp-hand"></div></body>',{url:'https://lab.test/'});Object.assign(globalThis,{document:dom.window.document,window:dom.window});
+const {createLearningRoutes,MAX_ROUTES}=await import('../dist/learning-routes.mjs');const doc=dom.window.document;
+const nodes=new Map();const point=z=>{const k=z.controller+':'+z.location+':'+z.sequence;if(!nodes.has(k)){const n=doc.createElement('div');n.getBoundingClientRect=()=>({left:100+z.sequence*90,top:z.location===16?600:300,width:80,height:110});doc.body.append(n);nodes.set(k,n)}return nodes.get(k)};
+const routes=createLearningRoutes({layer:doc.querySelector('#layer'),point,db:()=>({}),on:()=>true});
+for(let i=0;i<10;i++)routes.flight({type:'move',code:1000+i,from:{controller:0,location:16,sequence:i},to:{controller:0,location:4,sequence:i%5},reason:0x40},0,400);
+const svgs=doc.querySelectorAll('#layer svg').length;assert.ok(svgs>0&&svgs<=MAX_ROUTES,'route lines capped at '+MAX_ROUTES+' (got '+svgs+')');
+// 4. Chip placement
+doc.querySelector('#opp-hand').getBoundingClientRect=()=>({top:32,bottom:106,height:74,left:354,width:472});
+const {createLearningCaptions,CAPTION_MS}=await import('../dist/learning-captions.mjs');
+const cap=createLearningCaptions({root:doc.body,getDecks:()=>[{id:'branded',name:'Crimson Abyss'},{id:'luna',name:'Moonlit Hunt'}],on:()=>true,timingScale:0.01});
+cap.state({state:{turn:1,finished:false},coach:{last:null,intent:{seat:0,turn:1,book:{kind:'step',rule:'Opening book L-01'}}}});
+await new Promise(r=>setTimeout(r,CAPTION_MS.banner*0.01+30));const chip=doc.querySelector('.lr-plan');
+assert.ok(chip.classList.contains('lr-plan-mini'));assert.equal(chip.style.top,'112px','chip just below the revealed hand');
+cap.state({state:{turn:2,finished:false},coach:{last:null,intent:null}});assert.equal(chip.style.top,'','reset when hidden');
+console.log(JSON.stringify({test:'r33-polish',pass:true,routeCap:MAX_ROUTES,node:process.version,selfVerified:true}));
diff --git a/tools/r33-deck-brain.mjs b/tools/r33-deck-brain.mjs
new file mode 100644
index 0000000..989c442
--- /dev/null
+++ b/tools/r33-deck-brain.mjs
@@ -0,0 +1,34 @@
+// r33 deck brain drafter (Claude, 23 Oct). Kevy 22 Oct 23:29: "the AI needs more in depth combo books ... it needs to know
+// each card synergy and potential pathways and combos".
+// Reads one preset deck and drafts its card-to-card links from the printed card text: which deck cards each card can
+// search, Special Summon, send to the GY, Fusion Summon or be material for. Quoted names in the text are matched to the
+// deck's own cards by exact name or archetype (a quoted word that is part of a card's name, e.g. "Branded"). The verbs
+// are read per sentence, so a draft can be wrong: a person (Akiza) reviews it before it is trusted. The reviewed result
+// lives in dist/ai/brain/<deck>-brain.mjs; this tool only drafts.
+//   node tools/r33-deck-brain.mjs --deck branded [--list tcg-2026-10-19] [--out file.json]
+import fs from 'node:fs';import zlib from 'node:zlib';
+const arg=(k,v)=>{const i=process.argv.indexOf('--'+k);return i>0?process.argv[i+1]:v};
+export function draftBrain(deckId,listId='tcg-2026-10-19',dir='dist'){
+ const db=JSON.parse(zlib.gunzipSync(fs.readFileSync(dir+'/cards.json.gz'))),over=JSON.parse(fs.readFileSync(dir+'/text-overrides-tcg.json','utf8')).cards||{};
+ const base=JSON.parse(fs.readFileSync(dir+'/decks.json','utf8')).decks.find(d=>d.id===deckId);if(!base)throw new Error('no deck '+deckId);
+ const deck={...base,...(base.banlistVariants?.[listId]||{})};
+ const card=c=>({...db[c],name:over[c]?.name||db[c].name,desc:over[c]?.desc||db[c].desc});
+ const cards=[...new Set([...deck.main,...deck.extra])].map(c=>({code:c,zone:deck.main.includes(c)?'main':'extra',...card(c)}));
+ const names=cards.map(c=>c.name);
+ // "Branded" matches every deck card whose name contains Branded; a full card name matches only that card. Cards that are
+ // "always treated as" an archetype count too.
+ const treated=c=>[...(c.desc.match(/always treated as (?:an? )?((?:"[^"]+"(?:,? (?:and|or) )?)+)/)?.[1]?.matchAll(/"([^"]+)"/g)||[])].map(m=>m[1]);
+ const matches=q=>cards.filter(c=>c.name===q||(!names.includes(q)&&(c.name.includes(q)||treated(c).includes(q)))).map(c=>c.name);
+ const VERBS=[['search',/add (?:it|them|.{0,90}?) to (?:your|the) hand|add .{0,120}? from your (?:Deck|GY)/i],['summon',/Special Summon/i],['send',/send .{0,80}? to the GY|sending .{0,40}? to the GY/i],['fusion',/Fusion Summon/i],['banish',/banish/i]];
+ const out={};
+ for(const c of cards){const links={};const sentences=c.desc.split(/(?<=[.;:])\s+|\n/);
+  for(const s of sentences){const qs=[...s.matchAll(/"([^"]+)"/g)].map(m=>m[1]).filter(q=>q!==c.name);if(!qs.length)continue;
+   const targets=[...new Set(qs.flatMap(matches))].filter(n=>n!==c.name);if(!targets.length)continue;
+   for(const [verb,re] of VERBS)if(re.test(s))for(const t of targets)(links[verb]??=new Set()).add(t);
+   if(/^[^.]*\+/.test(s)&&c.zone==='extra')for(const t of targets)(links.material??=new Set()).add(t)}
+  out[c.name]={zone:c.zone,copies:(c.zone==='main'?deck.main:deck.extra).filter(x=>x===c.code).length,...Object.fromEntries(Object.entries(links).map(([k,v])=>[k,[...v].sort()]))}}
+ // Reverse links: what reaches each card.
+ for(const [n,l] of Object.entries(out))for(const verb of ['search','summon','send','fusion'])for(const t of l[verb]||[])((out[t].reachedBy??={})[verb]??=[]).push(n);
+ return {deck:deckId,list:listId,cards:out}}
+if(import.meta.url===`file://${process.argv[1]}`){const r=draftBrain(arg('deck','branded'),arg('list','tcg-2026-10-19'));const o=arg('out',null);
+ if(o)fs.writeFileSync(o,JSON.stringify(r,null,1));else for(const [n,l] of Object.entries(r.cards)){const {zone,copies,reachedBy,...links}=l;console.log(`${copies}x ${n} [${zone}]`);for(const [k,v] of Object.entries(links))console.log(`   ${k}: ${v.join(', ')}`);if(reachedBy)console.log('   <- '+Object.entries(reachedBy).map(([k,v])=>k+': '+v.join(', ')).join(' | '))}}
diff --git a/tools/r33-deck-cards.mjs b/tools/r33-deck-cards.mjs
new file mode 100644
index 0000000..bb20be3
--- /dev/null
+++ b/tools/r33-deck-cards.mjs
@@ -0,0 +1,18 @@
+// r33 (Claude, 23 Oct; Kevy 22 Oct 23:29: "when selecting a deck maybe we can include an option to view the deck list so
+// the user can see which cards are in the deck. Will also make it better for me for irl deck building").
+// Builds dist/deck-cards.json: the few fields the deck-list viewer needs (name, frame, level, ATK/DEF, art) for every card
+// in every preset deck, its banlist variants and its Side Deck, so the setup screen doesn't have to unpack the 1.6 MB
+// card library. Names follow the TCG text overrides, as the duel does. Re-run after any decks.json or card change:
+//   node tools/r33-deck-cards.mjs            (writes dist/deck-cards.json)
+//   node tools/r33-deck-cards.mjs --check    (exit 1 if the file is out of date)
+import fs from 'node:fs';import zlib from 'node:zlib';
+export function buildDeckCards(dir='dist'){
+ const db=JSON.parse(zlib.gunzipSync(fs.readFileSync(dir+'/cards.json.gz'))),over=JSON.parse(fs.readFileSync(dir+'/text-overrides-tcg.json','utf8')).cards||{};
+ const decks=JSON.parse(fs.readFileSync(dir+'/decks.json','utf8')).decks,codes=new Set();
+ for(const d of decks)for(const v of [d,...Object.values(d.banlistVariants||{})])for(const z of ['main','extra','side'])for(const c of v[z]||[])codes.add(c);
+ const cards={};for(const c of [...codes].sort((a,b)=>a-b)){const x=db[c];if(!x)throw new Error('card '+c+' missing from cards.json.gz');
+  cards[c]={name:over[c]?.name||x.name,type:x.type,level:x.level&0xff,attribute:x.attribute,atk:x.attack,def:x.defense,art:x.art||null}}
+ return {_meta:{by:'tools/r33-deck-cards.mjs',cards:Object.keys(cards).length},cards}}
+if(import.meta.url===`file://${process.argv[1]}`){const out=JSON.stringify(buildDeckCards())+'\n',file='dist/deck-cards.json';
+ if(process.argv.includes('--check')){const ok=fs.existsSync(file)&&fs.readFileSync(file,'utf8')===out;console.log(ok?'deck-cards.json up to date':'deck-cards.json OUT OF DATE');process.exit(ok?0:1)}
+ fs.writeFileSync(file,out);console.log('wrote',file,out.length,'bytes')}
