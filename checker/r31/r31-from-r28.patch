+// r31 data file: Sky Striker playbook (Claude, 22 Oct 2026, for Kevy's "Pure Sky Striker"; Akiza review pending).
+// Built from the printed card texts and the r31 audit (20 seeded hands going first, base AI): turns often ended with
+// two Sky Striker Mobilize - Engage! still in hand while the Main Monster Zones were empty (Engage's only condition),
+// i.e. the deck's card-advantage engine was left unused.
+// r31 measured (20 hands going first, base AI): an Engage!-first line used Engage more (9 -> 5 left in hand) but ended
+// with fewer Extra Monster Zone Aces (15 -> 12-13 hands), so the line is NOT shipped; picks only, book-trust off.
+// Akiza: a proper Sky Striker book (going second first) is needed.
+// Core idea: keep the Main Monster Zones empty, draw first (Upstart Goblin), fire every Engage! (search a Sky Striker
+// card; draw 1 more once 3+ Spells are in the GY), make the Extra Monster Zone Ace with Raye / Linkage!, and set the
+// Mecha / Maneuver Quick-Plays (Widow Anchor, Jamming Waves!, Afterburners!) for the opponent's turn.
+export default {
+ "deck": "sky",
+ "trust": false,
+ "source": "Claude r31 from the printed card texts and the r31 audit; not yet reviewed by Akiza or Alexis.",
+ "starters": ["Sky Striker Mobilize - Engage!", "Sky Striker Ace - Raye", "Reinforcement of the Army", "Sky Striker Mecha - Hornet Drones", "Sky Striker Mobilize - Linkage!"],
+ "lines": [],
+ "picks": [
+  {"source": "Sky Striker Mobilize - Engage!", "hint": [506], "ifNotHand": ["Sky Striker Ace - Raye"], "prefer": ["Sky Striker Ace - Raye", "Sky Striker Mobilize - Linkage!", "Sky Striker Mecha - Widow Anchor"]},
+  {"source": "Sky Striker Mobilize - Engage!", "hint": [506], "ifNotHand": ["Sky Striker Mobilize - Linkage!"], "prefer": ["Sky Striker Mobilize - Linkage!", "Sky Striker Mecha - Widow Anchor"]},
+  {"source": "Sky Striker Mobilize - Engage!", "hint": [506], "prefer": ["Sky Striker Mecha - Widow Anchor", "Sky Striker Maneuver - Jamming Waves!", "Sky Striker Mobilize - Linkage!", "Sky Striker Maneuver - Afterburners!", "Sky Striker Mecha - Hornet Drones"]},
+  {"source": "Reinforcement of the Army", "prefer": ["Sky Striker Ace - Raye", "Sky Striker Ace - Roze"]}
+ ],
+ "blocks": []
+};
