diff --git a/tools/r35-title-probe.mjs b/tools/r35-title-probe.mjs
new file mode 100644
index 0000000..d3799bb
--- /dev/null
+++ b/tools/r35-title-probe.mjs
@@ -0,0 +1,26 @@
+// r35 (Claude, 23 Oct): runs base-AI duels, replays each chain activation / resolution through effectFocus with the Lab
+// and TCG-UI card text, and reports how many get a RELAY-026 action title, the titles shown, and any title whose
+// highlighted clause is not exactly the mapped clause (must be 0).  node tools/r35-title-probe.mjs [duels-per-deck]
+import fs from 'node:fs';import zlib from 'node:zlib';
+import {Duel} from '../dist/duel.mjs';import {createOptimalPilots} from '../dist/optimal-pilot.mjs';import {safeView} from '../dist/ai/knowledge.mjs';
+import {effectFocus} from '../dist/effect-focus.mjs';import {EFFECT_TITLES} from '../dist/effect-titles.mjs';
+globalThis.onmessage=null;const {applyTextOverrides}=await import('../dist/library-worker.mjs');
+const N=+(process.argv[2]||1);
+const db=JSON.parse(zlib.gunzipSync(fs.readFileSync('dist/cards.json.gz'))),scripts=JSON.parse(zlib.gunzipSync(fs.readFileSync('dist/scripts.json.gz')));
+const ui=structuredClone(db);applyTextOverrides(ui,JSON.parse(fs.readFileSync('dist/text-overrides-tcg.json')).cards);
+const all=JSON.parse(fs.readFileSync('dist/decks.json')).decks.map(d=>d.banlistVariants?.['tcg-2026-10-19']?{...d,...d.banlistVariants['tcg-2026-10-19']}:d);
+const live=await Duel.create(db,scripts);const stat={events:0,titled:0,mismatch:[],titles:{},untitledKeys:{}};
+for(const me of all)for(let k=0;k<N*(all.length-1);k++){const opp=all.filter(d=>d.id!==me.id)[k%(all.length-1)],seed=7300+k,first=k%2;
+ const d=new Duel(live.core,db,scripts),pilots=createOptimalPilots({seed,searchEnabled:false});let dec=0,seen=0;const links=new Map();
+ try{d.start([me,opp],{seed,first});while(d.prompt&&!d.finished&&dec<1500){const p=pilots[d.prompt.seat],plan=p.base(safeView(d,d.prompt.seat));if(!plan?.response)break;d.respond(plan.response);p.observe(plan);dec++;
+  for(const e of d.events.slice(seen)){if(e.type==='activate')links.set(e.chain,e);if(!['activate','resolve'].includes(e.type))continue;
+   const ev=e.type==='resolve'?{...links.get(e.chain),...e,type:'resolve'}:e;if(!ev.code)continue;
+   for(const [name,cards] of [['lab',db],['ui',ui]]){const f=effectFocus(ev.code,ev.focusDescription||ev.description,cards,ev);if(!f)continue;stat.events++;
+    const n=BigInt(ev.description||0),key=n===0n?'zero':n<10000n?'native:'+n:String(n&0xFFFFFn),entry=EFFECT_TITLES[ev.code]?.[key];
+    if(f.title){stat.titled++;const m=entry?.variants?entry.variants.find(v=>v.title===f.title):entry;
+     if(!m||![m.clause,m.tcgClause].some(c=>c&&c.includes(f.fullExcerpt)))stat.mismatch.push([ev.code,key,f.title]);
+     stat.titles[cards[ev.code].name+' ['+key+'] → '+f.title]=(stat.titles[cards[ev.code].name+' ['+key+'] → '+f.title]||0)+1}
+    else if(entry&&!f.noEffect)stat.untitledKeys[cards[ev.code].name+' ['+key+'] loc '+(ev.effectLocation??ev.location)+' '+ev.type]=(stat.untitledKeys[cards[ev.code].name+' ['+key+'] loc '+(ev.effectLocation??ev.location)+' '+ev.type]||0)+1}}
+  seen=d.events.length}}catch(err){console.error(me.id,opp.id,seed,err.message)}}
+console.log(JSON.stringify({node:process.version,events:stat.events,titled:stat.titled,mismatch:stat.mismatch.length,mismatches:stat.mismatch.slice(0,20),distinctTitles:Object.keys(stat.titles).length},null,1));
+fs.writeFileSync(process.env.OUT||'/dev/stdout',JSON.stringify(stat,null,1));
