diff --git a/tests/r35-effect-titles.test.mjs b/tests/r35-effect-titles.test.mjs
new file mode 100644
index 0000000..97ed8eb
--- /dev/null
+++ b/tests/r35-effect-titles.test.mjs
@@ -0,0 +1,41 @@
+// r35 (Claude, 23 Oct): RELAY-026 action titles (dist/effect-titles.mjs, generated by tools/build-effect-titles.mjs).
+// 1. Data: every clause is an exact substring of the Lab or TCG UI text; titles are 1..48 characters; only kept kinds.
+// 2. Routing: shared engine descriptions use "native:<n>" first, raw 0 uses "zero", Stringids use the index.
+// 3. RELAY-026 hotspots: Double-Edged Sword raw 0 = the 2000-damage send-to-GY trigger (old override removed); 1068 = the
+//    Equip ATK rule; Lunalight Tiger / Wolf Pendulum placement (1160) resolves nothing; context-dependent records pick
+//    their variant by location / chain link and show no title without that context (True Light activation); a yes/no
+//    prompt chosen during resolution (Tenki) falls back to the activation's description.
+// 4. When another source (EFFECT_CLAUSES / override) supplies the highlighted clause, a title whose clause does not
+//    contain it is never shown.
+import assert from 'node:assert/strict';import fs from 'node:fs';import {gunzipSync} from 'node:zlib';
+import {effectFocus} from '../dist/effect-focus.mjs';import {EFFECT_TITLES} from '../dist/effect-titles.mjs';
+globalThis.onmessage=null;const {applyTextOverrides}=await import('../dist/library-worker.mjs');
+const lab=JSON.parse(gunzipSync(fs.readFileSync('dist/cards.json.gz'))),ui=structuredClone(lab);applyTextOverrides(ui,JSON.parse(fs.readFileSync('dist/text-overrides-tcg.json')).cards);
+const body=c=>(c?.desc||'').split(/\r?\n\r?\n\* The above text/)[0].trim(),code=n=>+Object.keys(lab).find(k=>lab[k].name===n);
+// 1
+let n=0;for(const [c,keys] of Object.entries(EFFECT_TITLES))for(const [k,e] of Object.entries(keys))for(const r of e.variants||[e]){n++;
+ assert.match(k,/^(zero|native:\d{1,4}|\d+)$/,c+':'+k);assert.ok(r.title&&r.title.length<=48,c+':'+k+' title');
+ for(const cl of [r.clause,r.tcgClause].filter(Boolean))assert.ok(body(lab[c]).includes(cl)||body(ui[c]).includes(cl),c+':'+k+' clause not exact text')}
+assert.ok(n>=380,'records '+n);
+// 2 + 3
+const sword=code('Double-Edged Sword');
+let f=effectFocus(sword,0n,lab,{type:'resolve',location:8});assert.equal(f.label,'Send Sword to the GY after 2000+ damage');assert.match(f.fullExcerpt,/2000 or more battle damage/);
+f=effectFocus(sword,1068n,lab,{type:'activate',location:8});assert.equal(f.label,'Equip: +2000 ATK; both take battle damage');assert.match(f.excerpt,/gains 2000 ATK/);
+for(const name of ['Lunalight Tiger','Lunalight Wolf']){f=effectFocus(code(name),1160n,lab,{type:'activate',location:8});assert.equal(f.noEffect,true,name);assert.equal(f.excerpt,null,name)}
+const tiger=code('Lunalight Tiger');f=effectFocus(tiger,(BigInt(tiger)<<20n)|0n,lab,{type:'activate',location:8});assert.match(f.label,/revive a Lunalight/i,'Tiger Pendulum effect itself still titled');
+const sage=code('Sage with Eyes of Blue');
+f=effectFocus(sage,0n,lab,{type:'activate',location:4});assert.equal(f.title,'Add a Level 1 LIGHT Tuner');
+f=effectFocus(sage,0n,lab,{type:'activate',location:2});assert.equal(f.title,'Discard Sage: send an ally; summon Blue-Eyes');
+assert.equal(effectFocus(sage,0n,lab,{type:'activate'}).title,undefined,'no location: no variant title');
+const tl=code('True Light');
+assert.equal(effectFocus(tl,0n,lab,{type:'activate',location:8}).title,undefined,'True Light activation: no action title');
+f=effectFocus(tl,0n,lab,{type:'activate',location:16});assert.equal(f.title,'Destroy all your monsters');
+const fusion=code('Branded Fusion');f=effectFocus(fusion,1170n,ui,{type:'activate',location:8});assert.equal(f.title,EFFECT_TITLES[fusion]['native:1170'].title,'native route');
+const tenki=code('Fire Formation - Tenki');f=effectFocus(tenki,(BigInt(tenki)<<20n)|0n,lab,{type:'resolve',location:8,description:0});
+assert.equal(f.title,'Add a Level 4 or lower Beast-Warrior','a yes/no prompt during resolution falls back to the activation description');
+// 4
+const imp=code('Infinite Impermanence'),saved=EFFECT_TITLES[imp];
+assert.equal(effectFocus(imp,0n,lab,{type:'activate',location:8}).title,saved.zero.title,'reviewed EFFECT_CLAUSES excerpt is part of the mapped clause');
+EFFECT_TITLES[imp]={zero:{clause:'If you control no cards, you can activate this card from your hand.',title:'WRONG CLAUSE'}};
+const g=effectFocus(imp,0n,lab,{type:'activate',location:8});assert.notEqual(g.title,'WRONG CLAUSE');assert.match(g.excerpt,/negate its effects/);EFFECT_TITLES[imp]=saved;
+console.log(JSON.stringify({test:'r35-effect-titles',pass:true,records:n,node:process.version,selfVerified:true}));
diff --git a/tools/build-effect-titles.mjs b/tools/build-effect-titles.mjs
new file mode 100644
index 0000000..54b8ffd
--- /dev/null
+++ b/tools/build-effect-titles.mjs
@@ -0,0 +1,67 @@
+// r35 (Claude, 23 Oct 2026): builds dist/effect-titles.mjs from ChatGPT's RELAY-026 clause/title map
+// (tools/data/relay-026-effect-titles.json, sha256 50f756df6d3d6baf35afd34942c6d3c4933877c64c28fbe07e6bb940fbb344bb).
+// Rules (RELAY-026, Seto S2 item 2):
+//  - Keys: "native:<n>" for shared engine descriptions (n < 10000), "zero" for raw description 0, "<i>" for Stringid i.
+//  - Kept kinds: effect, delayed. Dropped: status, prompt-or-legacy-alias, procedure, replacement, activation-only
+//    (placing / activating a card that does nothing by itself never gets an action title).
+//  - context-dependent records are kept only through the variant rules below (location / chain / event type);
+//    without a matching context no title is shown.
+//  - A clause is kept only if it is an exact substring of the Lab text or the TCG UI text; at run time the title is
+//    used only when the highlighted clause is exactly that clause.
+//  - Titles are at most 48 characters.
+// Usage: node tools/build-effect-titles.mjs [--check]   (--check: report only, do not write)
+import fs from 'node:fs';import {gunzipSync} from 'node:zlib';import crypto from 'node:crypto';
+globalThis.onmessage=null;const {applyTextOverrides}=await import('../dist/library-worker.mjs');
+const SRC='tools/data/relay-026-effect-titles.json',SHA='50f756df6d3d6baf35afd34942c6d3c4933877c64c28fbe07e6bb940fbb344bb';
+const raw=fs.readFileSync(SRC);if(crypto.createHash('sha256').update(raw).digest('hex')!==SHA)throw new Error('RELAY-026 data hash changed');
+const map=JSON.parse(raw);
+const lab=JSON.parse(gunzipSync(fs.readFileSync('dist/cards.json.gz'))),ui=structuredClone(lab);
+applyTextOverrides(ui,JSON.parse(fs.readFileSync('dist/text-overrides-tcg.json')).cards);
+const body=c=>(c?.desc||'').split(/\r?\n\r?\n\* The above text/)[0].trim();
+const KEEP=new Set(['effect','delayed']);
+// Variant selection for context-dependent records, in RELAY-026 variant order (null = never titled).
+// loc: effect location (2 hand, 4 Monster Zone, 16 GY); chain: [min,max] chain link; types: event types.
+const VARIANT_RULES={
+ '8240199:zero':[{loc:[4]},{loc:[2]}],                       // Sage: Normal Summon trigger on field / hand ignition
+ '10443957:zero':[{chain:[1,1]},{chain:[2,99]}],             // ignition is always CL1; the Quick Effect always answers an activation
+ '42097666:2':[null,{types:['activate','resolve']}],         // index 2 is also a menu hint; title only the chain activation
+ '56532353:zero':[{loc:[4]},{loc:[16]}],                     // field battle trigger / GY Quick Effect
+ '62089826:zero':[null,{loc:[16]}],                          // True Light: the activation does nothing itself; GY trigger destroys
+ '66574418:zero':[{loc:[4]},{loc:[16]}]                      // field / GY ignition
+};
+const out={},report={kept:0,variants:0,dropped:{},bad:[]};
+const drop=(why,id)=>{(report.dropped[why]||=[]).push(id)};
+function clauses(code,r){
+ const t=[body(lab[code]),body(ui[code])];
+ const c=[r.clause,r.tcgClause].filter(Boolean).filter((x,i,a)=>a.indexOf(x)===i&&t.some(s=>s.includes(x)));
+ return c.length?{clause:c[0],...(c[1]?{tcgClause:c[1]}:{})}:null;
+}
+for(const [code,keys] of Object.entries(map)){
+ if(!lab[code]){drop('card not in database',code);continue}
+ for(const [key,r] of Object.entries(keys)){
+  const id=code+':'+key;
+  if(r.requiresContext||r.kind==='context-dependent'){
+   const rules=VARIANT_RULES[id];if(!rules||!r.variants){drop('context without rule',id);continue}
+   const vs=[];r.variants.forEach((v,i)=>{const rule=rules[i];if(!rule)return;const c=clauses(code,v);
+    if(!c){report.bad.push(id+' variant '+i+': clause not in card text');return}
+    if(v.title.length>48){report.bad.push(id+' variant '+i+': title over 48');return}
+    vs.push({...rule,...c,title:v.title})});
+   if(vs.length){(out[code]||={})[key]={variants:vs};report.variants+=vs.length}
+   continue;
+  }
+  if(!KEEP.has(r.kind)){drop(r.kind,id);continue}
+  const c=clauses(code,r);if(!c){report.bad.push(id+': clause not in card text');continue}
+  if(!r.title||r.title.length>48){report.bad.push(id+': title missing or over 48');continue}
+  (out[code]||={})[key]={...c,title:r.title};report.kept++;
+ }
+}
+const summary={kept:report.kept,variants:report.variants,cards:Object.keys(out).length,dropped:Object.fromEntries(Object.entries(report.dropped).map(([k,v])=>[k,v.length])),bad:report.bad};
+console.log(JSON.stringify(summary,null,1));
+if(!process.argv.includes('--check')){
+ const head=`// r35 data file, GENERATED by tools/build-effect-titles.mjs from ChatGPT RELAY-026 (sha256 ${SHA.slice(0,16)}…). Do not edit by hand.
+// Shape: {"<code>": {"<key>": {clause, tcgClause?, title} | {variants:[{loc?|chain?|types?, clause, tcgClause?, title}]}}}.
+// key = "native:<n>" (shared engine description), "zero" (raw description 0) or the Stringid index. A title is shown only
+// when the highlighted clause is exactly the mapped clause (effect-focus.mjs). Data only.
+`;
+ fs.writeFileSync('dist/effect-titles.mjs',head+'export const EFFECT_TITLES='+JSON.stringify(out,null,0).replace(/\},"(\d+)":/g,'},\n"$1":')+';\n');
+}
