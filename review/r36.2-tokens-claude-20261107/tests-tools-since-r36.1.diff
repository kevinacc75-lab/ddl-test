+// r36.2 token cards browser check (Claude as builder, 7 Nov 2026). Chromium via the pre-installed Playwright.
+//  play     - Duel pace Watch duel; once the field is drawn, the page's own summon broadcast ('duel-presentation-event') is sent
+//             for 4 Scapegoat Tokens on our zones 0-3 (as Sleepy Scapegoats does): 4 overlays appear, show the token card image,
+//             a mid-animation screenshot is taken, and all overlays are gone afterwards. A non-token code plays nothing.
+//  instant  - the same broadcast at Instant pace plays nothing.
+//  real     - [deckA,deckB,seed,first] a real Watch duel at Duel pace until a token is summoned by the engine: the overlay
+//             appears on its own, and the field card then shows the token card image (not the text-only placeholder).
+// Usage: node tools/r36-token-browser.mjs <url> <outdir> [parts=play,instant,real] [real=dtw,branded,71040,0]
+import {createRequire} from 'node:module';import fs from 'node:fs';const require=createRequire(import.meta.url);
+const {chromium}=require('/opt/npm-tools/node_modules/playwright');
+const [url,out,partsArg='play,instant,real',realArg='dtw,branded,71040,0']=process.argv.slice(2);const PARTS=partsArg.split(',');fs.mkdirSync(out,{recursive:true});
+const browser=await chromium.launch(/^https:/.test(url)&&process.env.HTTPS_PROXY?{proxy:{server:process.env.HTTPS_PROXY}}:{});const report={url,parts:{}};
+async function page(preset){const ctx=await browser.newContext({viewport:{width:1366,height:900}});await ctx.addInitScript(pr=>{try{localStorage.setItem('doctrine-lab-media-v2',JSON.stringify({preset:pr,modePaces:{watch:pr,play:pr}}))}catch{}},preset);
+ const p=await ctx.newPage();const errors=[];p.on('pageerror',e=>errors.push(e.message));p.on('console',m=>{if(m.type()==='error')errors.push(m.text())});await p.goto(url);
+ await p.waitForFunction(()=>document.querySelector('#start')&&!document.querySelector('#start').disabled,null,{timeout:180000});return {p,ctx,errors}}
+const start=(p,a,b,seed,first=0)=>p.evaluate(([a,b,seed,first])=>{const $=s=>document.querySelector(s);$('#deck-a').value=a;$('#deck-a').dispatchEvent(new Event('change'));$('#deck-b').value=b;$('#deck-b').dispatchEvent(new Event('change'));$('#mode').value='watch';$('#mode').dispatchEvent(new Event('change'));$('#game-seed').value=seed;$('#first').value=String(first);$('#start').click()},[a,b,seed,first]);
+const fieldReady=p=>p.waitForFunction(()=>document.querySelectorAll('[data-slot^="0:4:"]').length>=5,null,{timeout:180000});
+const fire=(p,code,seqs)=>p.evaluate(([code,seqs])=>{for(const s of seqs)document.dispatchEvent(new CustomEvent('duel-presentation-event',{detail:{type:'summon',code,player:0,sequence:s,special:true,kind:'special'}}))},[code,seqs]);
+const fx=p=>p.evaluate(()=>[...document.querySelectorAll('.token-fx')].map(n=>({img:n.querySelector('.tf-card img')?.getAttribute('src'),tag:n.querySelector('.tf-tag')?.textContent,ms:n.style.getPropertyValue('--tf-ms')})));
+const run=async(name,f)=>{try{report.parts[name]=await f()}catch(e){report.parts[name]={pass:false,exception:e.message.split('\n')[0]}}console.log(name,JSON.stringify(report.parts[name]).slice(0,500))};
+if(PARTS.includes('play'))await run('play',async()=>{const {p,ctx,errors}=await page('duel');const R={};await start(p,'branded','sky','71034');await fieldReady(p);await p.waitForTimeout(7000);await p.evaluate(()=>document.querySelector('#notice')?.setAttribute('hidden',''));
+ await fire(p,3129528,[0,1,2,3]);await p.waitForTimeout(420);R.during=await fx(p);await p.screenshot({path:out+'/token-spawn-4a.png'});await p.waitForTimeout(330);await p.screenshot({path:out+'/token-spawn-4b.png'});
+ await p.waitForTimeout(1500);R.after=(await fx(p)).length;await fire(p,44146295,[0]);await p.waitForTimeout(300);R.nonToken=(await fx(p)).length;R.errors=errors;
+ R.pass=R.during.length===4&&R.during.every(x=>x.img==='art/73915052.jpg'&&x.tag==='TOKEN'&&x.ms==='1000ms')&&R.after===0&&R.nonToken===0&&!errors.length;await ctx.close();return R});
+if(PARTS.includes('instant'))await run('instant',async()=>{const {p,ctx,errors}=await page('instant');const R={};await start(p,'branded','sky','71034');await fieldReady(p);
+ await fire(p,52340445,[0,1]);await p.waitForTimeout(250);R.during=(await fx(p)).length;R.errors=errors.filter(e=>!/animate/.test(e));R.pass=R.during===0;await ctx.close();return R});
+if(PARTS.includes('real'))await run('real',async()=>{const [a,b,seed,first]=realArg.split(',');const {p,ctx,errors}=await page('duel');const R={a,b,seed,first};
+ await p.evaluate(()=>{window.__tok=[];new MutationObserver(ms=>{for(const m of ms)for(const n of m.addedNodes)if(n.classList?.contains('token-fx'))window.__tok.push({t:Date.now(),img:n.querySelector('.tf-card img')?.getAttribute('src')})}).observe(document.body,{childList:true})});
+ await start(p,a,b,seed,+first);const end=Date.now()+25*60000;let shot=false;
+ for(;;){const n=await p.evaluate(()=>window.__tok.length);if(n&&!shot){await p.waitForTimeout(350);await p.screenshot({path:out+'/token-real-spawn.png'});shot=true;await p.waitForTimeout(3500);break}
+  if(Date.now()>end||await p.evaluate(()=>!!document.querySelector('#duel-summary')))break;await p.waitForTimeout(150)}
+ R.spawns=await p.evaluate(()=>window.__tok);R.fieldTokenImgs=await p.evaluate(()=>[...document.querySelectorAll('[data-slot] img')].map(i=>i.getAttribute('src')).filter(s=>/token-generic|3129528|52340445|27204312|28674153|13935002|7391505/.test(s)));
