+// r37 bounded pin refresh (Claude as builder, 8 Nov 2026), same method as the r36 pins (ChatGPT RELAY-107/108): each pinned
+// file keeps its historical r35.12 (d3177e0) hash; its reviewed patch tests/fixtures/r36-pins/<file>.patch is the exact
+// `git diff --no-color d3177e0 -- <file>` and CANDIDATE.json holds the whole-file hash of the new candidate.
+// r37 adds dist/duel.mjs (the SELECT_SUM index conversion that goes with the core-library parser fix).
+import fs from 'node:fs';import crypto from 'node:crypto';import {execFileSync} from 'node:child_process';
+const sha=b=>crypto.createHash('sha256').update(b).digest('hex'),BASE='d3177e0';
+const files=['dist/app.mjs','dist/worker.mjs','dist/optimal-pilot.mjs','dist/presentation.mjs','dist/duel.mjs'];
+const cand={};for(const f of files){const patch=execFileSync('git',['diff','--no-color',BASE,'--',f],{encoding:'utf8',maxBuffer:1<<28});if(!patch)throw Error(f+': no change from '+BASE);
+ fs.writeFileSync('tests/fixtures/r36-pins/'+f.split('/').pop()+'.patch',patch);cand[f]=sha(fs.readFileSync(f))}
+fs.writeFileSync('tests/fixtures/r36-pins/CANDIDATE.json',JSON.stringify(cand,null,1).replace(/\n /g,'\n ')+'\n');
+const lib='tests/lib/r36-pins.mjs';let s=fs.readFileSync(lib,'utf8');const h=sha(execFileSync('git',['show',BASE+':dist/duel.mjs']));
+if(!s.includes("'dist/duel.mjs'"))s=s.replace("/* r36 default build: finished-duel dock line (RELAY-119) */};","/* r36 default build: finished-duel dock line (RELAY-119) */,'dist/duel.mjs':'"+h+"'/* r37: SELECT_SUM index conversion for the core parser fix */};");
+fs.writeFileSync(lib,s);console.log(JSON.stringify({cand,duelR3512:h}))
