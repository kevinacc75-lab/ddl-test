+<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
+  <!-- r37 WindBot in the browser (Claude as builder, 7 Nov 2026; Kevy: pick our AI for Deck A and WindBot for Deck B and watch
+       it live). Compiles the UNMODIFIED WindBot game logic + executors (ProjectIgnis/windbot, AGPL-3.0-or-later) for .NET browser-wasm.
+       Only the parts that need a desktop are replaced: the TCP client (packets go to/from JavaScript instead), the SQLite card
+       database (the site's own card data is loaded instead), and the Program statics. Build:
+       dotnet publish tools/windbot/web/WindBotWeb.csproj -c Release -p:WindBotSrc=<path to windbot checkout> -->
+  <PropertyGroup>
+    <TargetFramework>net8.0</TargetFramework>
+    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
+    <Nullable>disable</Nullable>
+    <ImplicitUsings>enable</ImplicitUsings>
+    <InvariantGlobalization>true</InvariantGlobalization>
+    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
+    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
+    <RootNamespace>WindBot</RootNamespace>
+    <AssemblyName>WindBotWeb</AssemblyName>
+    <OutputType>Exe</OutputType>
+    <WasmEnableThreads>false</WasmEnableThreads>
+    <PublishTrimmed>true</PublishTrimmed>
+    <TrimMode>partial</TrimMode>
+    <NoWarn>CS0414;CS0168;CS0219;CS0162;CS0649;CS0169;CS8632</NoWarn>
+  </PropertyGroup>
+  <ItemGroup>
+    <!-- executors are found by reflection (DeckAttribute), so the trimmer must keep them -->
+    <TrimmerRootAssembly Include="WindBotWeb" />
+  </ItemGroup>
+  <ItemGroup>
+    <Compile Include="*.cs" />
+    <Compile Include="$(WindBotSrc)/ExecutorBase/Game/**/*.cs" />
+    <Compile Include="$(WindBotSrc)/ExecutorBase/YGOSharp.OCGWrapper.Enums/*.cs" />
+    <Compile Include="$(WindBotSrc)/ExecutorBase/YGOSharp.OCGWrapper/Card.cs" />
+    <Compile Include="$(WindBotSrc)/ExecutorBase/YGOSharp.OCGWrapper/NamedCard.cs" />
+    <Compile Include="$(WindBotSrc)/Game/AI/Deck.cs" />
+    <Compile Include="$(WindBotSrc)/Game/AI/Decks/*.cs" />
+    <Compile Include="$(WindBotSrc)/Game/DecksManager.cs" />
+    <Compile Include="$(WindBotSrc)/Game/GameBehavior.cs" />
+    <Compile Include="$(WindBotSrc)/Game/GamePacketFactory.cs" />
+    <Compile Include="$(WindBotSrc)/Game/Room.cs" />
+    <Compile Include="$(WindBotSrc)/Logger.cs" />
+    <Compile Include="$(WindBotSrc)/YGOSharp.Network/Enums/*.cs" />
+    <Compile Include="$(WindBotSrc)/YGOSharp.Network/Utils/BinaryExtensions.cs" />
+  </ItemGroup>
+</Project>
