+// RELAY-044 Fire Dance ledger, NATIVE half (Claude, 28 Oct 2026). SELF-VERIFIED (builder = verifier), NOT independent.
+// Mikanko (seat 0) holds two Mikanko Fire Dance with Sanaki in the GY; Blue-Eyes (seat 1) may hold Ghost Belle.
+//  N1: Fire Dance activated and Belle negates its effect: fireDanceUsed(d,0) is true (the activation reached the chain),
+//      false for the opponent's seat.
+//  N2 (control, no Belle): after Fire Dance resolves, the engine does not offer the second copy this turn (once per turn).
+//  Recorded, not asserted: after Belle negates the EFFECT, the engine offers the second Fire Dance again (its script's
+//  EFFECT_COUNT_CODE_OATH count is refunded). TCG reading (Alexis to confirm): the card was still activated, so a second
+//  copy cannot be activated that turn. The AI's ledger counts it as used either way.
+import assert from 'node:assert/strict';
+import {engine,stopEngine,scenario,drive,seatOf,labels,M,R} from '../tools/s3-harness.mjs';
+import {fireDanceUsed} from '../dist/ai/book/mikanko-plan.mjs';
+await engine();
+const FD='Mikanko Fire Dance',results={};
+function run(belle){const d=scenario(['mikanko','blueeyes'],[{name:FD,location:2,owner:0},{name:FD,location:2,owner:0},{name:'Sanaki the Mikanko Devotee',location:16,owner:0},{name:'Ha-Re the Sword Mikanko',location:16,owner:0},{name:'Ghost Belle & Haunted Mansion',location:2,owner:1}]);
+ let second=null;
+ const r=drive(d,{steps:{0:['Activate · '+FD],1:belle?['@'+FD+'>Chain · Ghost Belle']:[]},
+  onPrompt:dd=>{const m=dd.prompt;if(seatOf(m)!==0)return false;
+   if(m.type===M.SELECT_CARD&&dd.name(dd.currentEffect?.code||0)===FD){dd.respond({type:R.SELECT_CARD,indicies:[0]});return true}
+   if([M.SELECT_PLACE,M.SELECT_POSITION].includes(m.type)){dd.respond(dd.choices()[0].response);return true}
+   if([M.SELECT_EFFECTYN,M.SELECT_YESNO].includes(m.type)){dd.respond(dd.choices().find(c=>c.label==='No').response);return true}return false},
+  until:dd=>{const m=dd.prompt;if(seatOf(m)===0&&m.type===M.SELECT_IDLECMD&&[...dd.zone(0,16),...dd.zone(0,8)].some(c=>c&&dd.name(c.code)===FD)){second=labels(dd).filter(l=>l==='Activate · '+FD).length;return true}return false},max:150});
+ assert.ok(r.stopped,'reached the idle prompt after Fire Dance (belle '+belle+'): '+JSON.stringify(r.stuck||r.unused));
+ const out={belle,usedSeat0:fireDanceUsed(d,0),usedSeat1:fireDanceUsed(d,1),secondOffered:second};d.stop();return out}
+const neg=run(true),ctl=run(false);
+assert.equal(neg.usedSeat0,true,'N1: Fire Dance whose effect Belle negated counts as used this turn');assert.equal(neg.usedSeat1,false,'N1: not for the other seat');
+assert.equal(ctl.usedSeat0,true,'N2: resolved Fire Dance counts as used');assert.equal(ctl.secondOffered,0,'N2: the engine does not offer the second copy after a resolved Fire Dance');
+results.N1=neg;results.N2=ctl;results.divergence=neg.secondOffered>0?'engine offers the second Fire Dance after its effect was negated (OATH refund); TCG reading: not allowed':'none';
+stopEngine();
+console.log(JSON.stringify({test:'r35-firedance-native',pass:true,node:process.version,results}));
