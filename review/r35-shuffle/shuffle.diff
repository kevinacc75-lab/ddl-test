+// r35 item 8 (Claude, 28 Oct 2026). SELF-VERIFIED (builder = verifier), NOT independent. NATIVE engine detection fixture
+// for the deck-shuffle tap (RELAY-046 "Detection fixture"; Seto 27 Oct 10:10). The real ShuffleTap is installed on a real
+// Duel before its first start (as worker.mjs does), and an INDEPENDENT raw recorder (wrapped outside it) logs every
+// SHUFFLE_DECK / SHUFFLE_HAND the engine sends. The tap must report exactly the armed-time SHUFFLE_DECK messages, by seat.
+//  S1 startup: the engine's start-up shuffles (a SHUFFLE_HAND here) are never captured (disarmed until start returns).
+//  S2 a search (Aluber the Jester of Despia adds a Branded card from the Deck): the engine sends SHUFFLE_HAND then
+//     SHUFFLE_DECK for that seat; the tap captures exactly one entry, seat 0, after the Deck-to-hand move event.
+//  S3 a draw (Deck-to-hand MOVE with no shuffle) captures nothing.
+//  S4 first = 1: the engine numbers players the other way; the tap still reports canonical seat 0.
+//  S5 reconstruction (rewind / start-with-responses / import): replaying the same responses into a fresh duel while the
+//     tap is disarmed captures nothing although the raw recorder sees the same shuffle; arming afterwards works.
+import assert from 'node:assert/strict';
+import {engine,stopEngine,scenario,drive,labels,seatOf,M} from '../tools/s3-harness.mjs';
+import {ShuffleTap} from '../dist/shuffle-tap.mjs';import {OcgResponseType as R} from '../dist/core/index.js';
+// End Phase hand-size discard (going second the search leaves 7 cards): discard the minimum, last cards first.
+const discard=dd=>{const m=dd.prompt;if(seatOf(m)!==0||m.type!==M.SELECT_CARD||labels(dd).length)return false;const n=(m.selects||[]).length,k=Math.max(1,m.min||1);dd.respond({type:R.SELECT_CARD,indicies:Array.from({length:k},(_,i)=>n-1-i)});return true};
+await engine();
+const ALUBER='Aluber the Jester of Despia';
+function make(first){const raw=[],tap=new ShuffleTap({shuffleType:M.SHUFFLE_DECK});
+ const d=scenario(['branded','blueeyes'],[{name:ALUBER,location:2,owner:0}],{first,beforeStart:d=>{tap.install(d);const inner=d.handleMessage;
