+// r35 item 8 (Claude, 28 Oct 2026). SELF-VERIFIED (builder = verifier), NOT independent. Unit tests of dist/shuffle-tap.mjs
+// against Seto's 27 Oct 10:10 conditions for the RELAY-046 Tap B interposition (synthetic duel objects, no engine).
+import assert from 'node:assert/strict';
+import {ShuffleTap,SHUFFLE_MAX_PENDING} from '../dist/shuffle-tap.mjs';
+import {M} from '../dist/duel.mjs';
+assert.ok(Number.isInteger(M.SHUFFLE_DECK)&&Number.isInteger(M.SHUFFLE_HAND)&&M.SHUFFLE_DECK!==M.SHUFFLE_HAND);
+class FakeDuel{constructor(first=0){this.order=first===0?[0,1]:[1,0];this.fromEngine=p=>this.order[p];this.eventSeq=0;this.seen=[]}
+ handleMessage(m){this.seen.push(m);this.eventSeq++;if(m.boom)throw Error('original failed');return 'r'+this.eventSeq}}
+const SD=p=>({type:M.SHUFFLE_DECK,player:p}),SH=p=>({type:M.SHUFFLE_HAND,player:p});
+// 1. The original runs first, once, with the same receiver and message; its result is returned.
+{const d=new FakeDuel(),t=new ShuffleTap({shuffleType:M.SHUFFLE_DECK});t.install(d);t.arm();const m=SD(0);
+ assert.equal(d.handleMessage(m),'r1');assert.equal(d.seen.length,1);assert.equal(d.seen[0],m,'same message object');
+ assert.ok(Object.prototype.hasOwnProperty.call(d,'handleMessage'),'own property on the instance');assert.notEqual(FakeDuel.prototype.handleMessage,d.handleMessage,'the prototype is untouched');
+ assert.deepEqual(t.drain(),{epoch:0,shuffles:[{id:1,seat:0,afterEventId:1}],dropped:0},'scalars only, afterEventId copied AFTER the original')}
+// 2. The original's error propagates unchanged and nothing is captured.
+{const d=new FakeDuel(),t=new ShuffleTap({shuffleType:M.SHUFFLE_DECK});t.install(d);t.arm();
+ assert.throws(()=>d.handleMessage({...SD(0),boom:true}),/original failed/);assert.equal(t.drain().shuffles.length,0)}
+// 3. Not armed (startup, reconstruction): nothing captured. SHUFFLE_HAND and other messages: never.
+{const d=new FakeDuel(),t=new ShuffleTap({shuffleType:M.SHUFFLE_DECK});t.install(d);d.handleMessage(SD(0));assert.equal(t.drain().shuffles.length,0,'disarmed');
