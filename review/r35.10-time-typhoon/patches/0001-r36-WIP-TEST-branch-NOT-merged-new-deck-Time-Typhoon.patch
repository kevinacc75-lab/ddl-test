+ (results.Q||={})[label]=offered;d.stop()}
+// O
+{const d=scenario(['dtw','dtw'],[{name:'Foolish Graverobber',location:8,owner:0,position:10},{name:'K9-17 Izuna',location:16,owner:1}],{first:1,seed:11});
