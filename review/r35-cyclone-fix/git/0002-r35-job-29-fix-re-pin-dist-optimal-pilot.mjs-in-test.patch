+// r35 job 29 fix (Claude, 29 Oct 2026). SELF-VERIFIED. dist/optimal-pilot.mjs is a PINNED file (tests/r23-fx.test.mjs:
+// pace, holds, think time). The Cosmic Cyclone / Hu-Li fix replaces exactly the three blocks below. Swapping each new block
+// back for its old text must give the previously pinned optimal-pilot.mjs byte for byte (sha256 8b8c03c3..., also the
+// frozen gate tree's copy), so nothing else in the file changed.
+import assert from 'node:assert/strict';import fs from 'node:fs';import crypto from 'node:crypto';
+const BLOCKS=[["// r35 job 29 fix (Claude, 29 Oct 2026; Seto 00:30 / 01:25, Alexis, Akiza): can WE target this OPPOSING card with a card\n// effect? Public information only (a face-down card's identity is never used).\n//  - Hu-Li the Jewel Mikanko (printed): \"While you control an Equip Card, your opponent cannot target 'Mikanko' cards you\n//    control with card effects.\" The shield is up when the opposing side has a FACE-UP, unnegated Hu-Li AND controls ANY\n//    Equip Card (a face-up card in ITS Spell/Trap Zone that is equipped to a monster, on either field). Under the shield\n//    their Mikanko cards are untargetable, and so is any face-down card of theirs (it may be a Mikanko card; we can't know).\n//    (Before: the Equip Card had to be equipped TO Hu-Li, and both players' zones were pooled; Hu-Li's face-up state was\n//    not checked. Job 29: Fire Dance was equipped to a monster on our field, so the old rule missed the shield.)\n//  - Catch-all for cards outside our 8-deck pool: an opposing face-up, unnegated card whose text grants \"your opponent\n//    cannot target ... Spell/Trap / cards you control\" makes their Spell/Trap Zone cards untargetable (conservative: we may\n//    hold a removal we could have used; we never fire one at our own cards). In our pool it matches Hu-Li only (tested).\nexport const HULI='Hu-Li the Jewel Mikanko',GRANTS_ST_SHIELD=/your opponent cannot target [^.]*(Spells?|Traps?|Spell\\/Traps?|cards you control)/i;\nconst faceUp=c=>!!c&&!!(c.position&5);\nexport function huLiShield(d,side){\n return d.zone(side,4).some(x=>faceUp(x)&&!(x.status&1)&&d.name(x.code)===HULI)&&d.zone(side,8).some(s=>faceUp(s)&&!!s.equipCard);\n}\nfunction otherStShield(d,side){\n return [...d.zone(side,4),...d.zone(side,8)].some(x=>faceUp(x)&&!(x.status&1)&&d.name(x.code)!==HULI&&GRANTS_ST_SHIELD.test(d.db[x.code]?.desc||''));\n}\nexport const targetable=(d,seat,c)=>{", "const targetable=(d,seat,c)=>{"], [" const foe=1-seat;\n if(huLiShield(d,foe)&&(!faceUp(c)||/Mikanko/.test(d.name(c.code))))return false;\n if(c.location===8&&otherStShield(d,foe))return false;\n return true;", " const enemy=d.zone(1-seat,4).filter(Boolean),spells=[...d.zone(1-seat,8),...d.zone(seat,8)].filter(Boolean);\n const hu=enemy.find(x=>d.name(x.code)==='Hu-Li the Jewel Mikanko'&&!(x.status&1)&&spells.some(s=>s.equipCard?.controller===1-seat&&s.equipCard?.sequence===x.sequence));\n return !(hu&&/Mikanko/.test(d.name(c.code)));"], [" // r35 job 29 fix: targeting Spell/Trap removal needs a TARGETABLE opposing Spell/Trap (not just one that exists): with\n // none, the engine would offer only our own cards and the effect would banish/destroy one of them. Blocked before\n // activation, so no cost is paid (Twin Twisters' discard, Tornado Dragon's detach). Galaxy Cyclone: the hand / field\n // activation targets a SET Spell/Trap; the GY effect targets a FACE-UP one.\n if(/^(Cosmic Cyclone|Mystical Space Typhoon|Twin Twisters|Tornado Dragon)$/.test(n)&&!enemy(8).some(s=>targetable(d,seat,s)))return n+' has no targetable opposing Spell/Trap';\n if(n==='Galaxy Cyclone'){const gy=c.location===16;if(!enemy(8).some(s=>(gy?faceUp(s):!faceUp(s))&&targetable(d,seat,s)))return n+' has no targetable opposing '+(gy?'face-up':'Set')+' Spell/Trap'}", " if(/^(Cosmic Cyclone|Mystical Space Typhoon|Twin Twisters|Tornado Dragon|Galaxy Cyclone)$/.test(n)&&!enemy(8).length)return n+' has no opposing Spell/Trap to remove';"]];
+let s=fs.readFileSync('dist/optimal-pilot.mjs','utf8');
+for(const [now,before] of BLOCKS){assert.equal(s.split(now).length-1,1,'block present exactly once: '+now.slice(0,60));s=s.replace(now,()=>before)}
+assert.equal(crypto.createHash('sha256').update(s).digest('hex'),'8b8c03c360961cca10b2f265c399d12dadeac589d00ba031d2620ad73f0960c7','optimal-pilot.mjs minus the fix = the pinned r22b..r35.5 file');
+console.log(JSON.stringify({test:'r35-cyclone-pin',pass:true,blocks:BLOCKS.length,node:process.version}));
