@@ -0,0 +1,17 @@
+// r36 S4a flag E (Claude as builder, 5 Nov 2026). Engine-native puzzle S2-e (tools/r36-s2-puzzles.mjs, controlled decks):
+// Scareclaw Kashtira in face-up Defence Position vs an empty board. With E off (default, both Classic and Enhanced
+// recipes) the battle planner drops the engine-offered attacker (r35 behaviour, kept for Classic parity); with E on it
+// attacks and its DEF is used. E is in no recipe until reviewed.
+import assert from 'node:assert/strict';import {execFileSync} from 'node:child_process';import fs from 'node:fs';import os from 'node:os';import path from 'node:path';
+import {S4,setS4} from '../dist/ai/s4-flags.mjs';import {AI_MODES} from '../dist/ai/midgame-flags.mjs';
+assert.deepEqual({...S4},{E:false},'E defaults off (no DDL_S4 in the test env)');
+assert.ok(!('E' in AI_MODES.classic)&&!('E' in AI_MODES.enhanced),'E is in neither recipe');
+assert.deepEqual(setS4({E:true}),{E:true});setS4({E:false});
+const out=fs.mkdtempSync(path.join(os.tmpdir(),'s4e-'));
+const run=f=>execFileSync(process.execPath,['tools/r36-s2-puzzles.mjs',out,'--only','e','--modes','classic,enhanced',...(f?['--flags',f]:[])],{encoding:'utf8'});
+const off=run(''),on=run('E');
+assert.match(off,/e classic s0: FAIL - engine offered Scareclaw Kashtira as an attacker: true; it attacked: false/,'E off, Classic: r35 behaviour');
+assert.match(off,/e enhanced s0: FAIL - engine offered Scareclaw Kashtira as an attacker: true; it attacked: false/,'E off, Enhanced: unchanged');
+assert.match(on,/e classic\+E s0: PASS .*it attacked: true/,'E on: attacks');assert.match(on,/e enhanced\+E s0: PASS .*it attacked: true/,'E on: attacks (Enhanced)');
+const T=JSON.parse(fs.readFileSync(out+'/e-classic+E-s0.json','utf8'));assert.equal(T.boardAfter[1].lp,8000-2600,'damage = Scareclaw Kashtira DEF 2600');
+console.log(JSON.stringify({test:'r36-s4-e',pass:true,node:process.version,selfVerified:true}));
diff --git a/tools/r36-s2-puzzles.mjs b/tools/r36-s2-puzzles.mjs
