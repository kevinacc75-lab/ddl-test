@@ -0,0 +1,58 @@
+// r35 rollover fix (Claude, 28 Oct 2026; RELAY-056 / RELAY-057). SELF-VERIFIED (builder = verifier), NOT independent.
+// The durable turn ledger (dist/ai/book/turn-ledger.mjs) and the Kitt revive checks built on it, against the duel's REAL
+// event() method (Duel.prototype.event: push with id, keep the last 120). No engine: a plain object stands in for the duel,
+// and AI views are Object.create(duel) exactly as safeView / the pilot shadow build them.
+import assert from 'node:assert/strict';import fs from 'node:fs';import {gunzipSync} from 'node:zlib';
+import {Duel} from '../dist/duel.mjs';import {turnLedger} from '../dist/ai/book/turn-ledger.mjs';
+import {sentToGyThisTurn,activatedThisTurn,epSearchPending,dogmaSlot4} from '../dist/ai/book/kitt-revive.mjs';
+const db=JSON.parse(gunzipSync(fs.readFileSync('dist/cards.json.gz'))),code=n=>+Object.keys(db).find(k=>db[k].name===n);
+const TITAN=code('Titaniklad the Ash Dragon'),DOGMA=code('The Dragon that Devours the Dogma'),ALBAZ=code('Fallen of Albaz');
+const ev=Duel.prototype.event;
+function duel(){const z={1:[{code:ALBAZ,controller:0,location:1,sequence:0}],16:[{code:ALBAZ,controller:0,location:16,sequence:0}]};
+ return {events:[],eventSeq:0,db,name:c=>db[c]?.name||'',zone:(s,l)=>s===0?(z[l]||[]):[],event:ev}}
+const view=d=>Object.create(d);/* as safeView */
+const sendTitan=d=>d.event('move',{code:TITAN,from:{location:4,controller:0},to:{location:16,controller:0}});
+const filler=(d,n)=>{for(let i=0;i<n;i++)d.event('hint',{text:'filler '+i})};
+const dogma0=d=>d.event('activate',{player:0,code:DOGMA,description:String(BigInt(DOGMA)<<20n)});
+// 1. Duel.event really keeps only 120 (the bug this fixes).
+{const d=duel();d.event('turn',{turn:1});sendTitan(d);filler(d,130);assert.equal(d.events.length,120);assert.ok(!d.events.some(e=>e.type==='move'),'the send rolled out of the window')}
+// 2. Observed, then rolled out: the ledger remembers (old code forgot and would revive Titaniklad).
+{const d=duel();d.event('turn',{turn:1});sendTitan(d);assert.equal(sentToGyThisTurn(view(d),0,TITAN),true);
+ for(let k=0;k<13;k++){filler(d,10);turnLedger(view(d))}/* the AI reads between batches */
+ assert.ok(!d.events.some(e=>e.type==='move'));const L=turnLedger(view(d));assert.equal(L.complete,true,'no gap: every event was seen');
+ assert.equal(sentToGyThisTurn(view(d),0,TITAN),true,'still known after rollover');assert.equal(epSearchPending(view(d),0,TITAN),true,'never revive it')}
+// 3. Never observed before rolling out: UNKNOWN, treated conservatively.
+{const d=duel();d.event('turn',{turn:1});sendTitan(d);dogma0(d);filler(d,130);
+ assert.equal(turnLedger(view(d)).complete,false);assert.equal(sentToGyThisTurn(view(d),0,TITAN),null,'unknown, not false');
+ assert.equal(epSearchPending(view(d),0,TITAN),true,'unknown = search pending (do not revive)');
+ assert.equal(activatedThisTurn(view(d),0,DOGMA,0),null);assert.equal(dogmaSlot4(view(d),0,DOGMA),false,'unknown = shuffle used (no slot 4)');
+ // 3b. The next turn starts a complete record again.
+ d.event('turn',{turn:2});assert.equal(turnLedger(view(d)).complete,true);assert.equal(sentToGyThisTurn(view(d),0,TITAN),false);
+ assert.equal(epSearchPending(view(d),0,TITAN),false);assert.equal(dogmaSlot4(view(d),0,DOGMA),true,'a GY card and an unused shuffle')}
+// 4. Rollover of an ACTIVATION that was observed: the used search stays used.
+{const d=duel();d.event('turn',{turn:1});sendTitan(d);d.event('activate',{player:0,code:TITAN,description:String(BigInt(TITAN)<<20n)});turnLedger(view(d));
+ for(let k=0;k<13;k++){filler(d,10);turnLedger(view(d))}
+ assert.equal(activatedThisTurn(view(d),0,TITAN,0),true);assert.equal(epSearchPending(view(d),0,TITAN),false,'search used: a body again')}
+// 5. Two effects of one card: Dogma's shuffle (0) used is not its End Phase search (1).
+{const d=duel();d.event('turn',{turn:1});dogma0(d);
+ assert.equal(activatedThisTurn(view(d),0,DOGMA,0),true);assert.equal(activatedThisTurn(view(d),0,DOGMA,1),false);assert.equal(activatedThisTurn(view(d),0,DOGMA),true,'any index')}
+// 6. Retry: the duel filters out the rejected 'effectChosen' into a NEW array (duel.mjs respond). Same history: no false gap.
+{const d=duel();d.event('turn',{turn:1});sendTitan(d);turnLedger(view(d));
+ d.event('effectChosen',{code:1});const bad=d.eventSeq;d.events=d.events.filter(e=>e.id!==bad);filler(d,3);
+ const L=turnLedger(view(d));assert.equal(L.complete,true,'a removed rejected selection is not a missed event');assert.equal(sentToGyThisTurn(view(d),0,TITAN),true,'history carried over');
+ // 6b. Absorbed, then removed by a retry: dropped from the ledger.
+ d.event('effectChosen',{code:2});turnLedger(view(d));const bad2=d.eventSeq;d.events=d.events.filter(e=>e.id!==bad2);
+ assert.ok(!turnLedger(view(d)).events.some(e=>e.id===bad2),'the rejected selection is gone')}
+// 7. Rewind / new duel: start() resets the array AND the ids: a fresh ledger, nothing carried over.
+{const d=duel();d.event('turn',{turn:1});sendTitan(d);filler(d,10);turnLedger(view(d));
+ d.events=[];d.eventSeq=0;d.event('turn',{turn:1});assert.equal(sentToGyThisTurn(view(d),0,TITAN),false,'the old duel\'s send does not leak');assert.equal(turnLedger(view(d)).complete,true);
+ sendTitan(d);assert.equal(sentToGyThisTurn(view(d),0,TITAN),true,'the new duel\'s events (low ids again) are absorbed')}
+// 8. Views of views (pilot shadow of a safeView) share the duel's ledger; another duel never does.
+{const d=duel(),e=duel();d.event('turn',{turn:1});sendTitan(d);turnLedger(view(view(d)));filler(d,130);
+ assert.equal(sentToGyThisTurn(view(d),0,TITAN),true,'seen via a view of a view');
+ e.event('turn',{turn:1});assert.equal(sentToGyThisTurn(view(e),0,TITAN),false,'separate duel, separate ledger')}
+// 9. A view with no events array (unit mock): the caller's fallback, nothing happened.
+assert.equal(turnLedger({}),null);assert.equal(sentToGyThisTurn({name:()=>''},0,TITAN),false);
+// 10. A fresh ledger on an empty duel, or one whose window still starts at id 1, is complete.
+{const d=duel();assert.equal(turnLedger(d).complete,true);d.event('hint',{});assert.equal(turnLedger(d).complete,true)}
+console.log(JSON.stringify({test:'r35-turn-ledger',pass:true,node:process.version}));
