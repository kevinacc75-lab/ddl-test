 // 7. Not Kitt's revive: untouched (another source, or another hint).
 assert.equal(bookPick(view({effect:code('Branded Fusion')}),0,{type:M.SELECT_CARD,selects:[card(TITAN),card(RIND)]},{indicies:[0]}),null,'other source: no Kitt rule');
 // 8. K3-02: the Branded Fusion material lists no longer prefer Kitt; a base choice of Ecclesia over Kitt is preserved.
 for(const r of BOOKS.branded.picks.filter(p=>p.source==='Branded Fusion'&&p.hint.includes(511)))assert.ok(!r.prefer.includes('Tri-Brigade Springans Kitt'),'Kitt is not a forced material preference');
