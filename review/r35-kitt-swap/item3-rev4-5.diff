+assert.equal(pick([DOGMA,LUB],{events:[{type:'turn'},{type:'activate',player:0,code:code(DOGMA),description:D0}]},0),LUB,'failed slot 4, no Ecclesia: after Lubellion');
+assert.ok(!kittReviveOrder(view(),0).includes('Tri-Brigade Springans Kitt'),'never Kitt itself');
+// 6b. Refined never-rule: only while a legal search target is still in our Deck.
