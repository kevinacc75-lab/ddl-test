diff --git a/tests/r35-kitt-revive.test.mjs b/tests/r35-kitt-revive.test.mjs
new file mode 100644
index 0000000..3dab491
--- /dev/null
+++ b/tests/r35-kitt-revive.test.mjs
@@ -0,0 +1,34 @@
+// r35 queue item 3 (Claude, 28 Oct 2026). SELF-VERIFIED (builder = verifier), NOT independent; ChatGPT review pending.
+// Tri-Brigade Springans Kitt (19304410) revive pick, per Alexis's rulings and Akiza's order (Seto handover 28 Oct 06:15):
+//  1. Going first: Albaz Fusion > Fallen of Albaz > Guiding Quem > Fallen of the White Dragon > Ecclesia > Cartesia >
+//     Mercourier > Albion the Shrouded Dragon.
+//  2. Going second: Ecclesia and Cartesia move up (Main Phase Quick Effects): Albaz > Ecclesia > Cartesia > Quem > ...
+//  3. A properly summoned Albaz Fusion in the GY comes first when the engine offers it.
+//  4. Kitt never picks itself (the engine never offers it; the book list doesn't name it either).
+//  5. The pick is a book preference only: when none of the offered cards are named, the base choice stands.
+// This is a synthetic-view unit fixture of the book rule. It is NOT a native duel fixture and NOT a strength measurement;
+// the native Branded Fusion -> Kitt-from-Deck fixture and the opponent-side key-card measurement are still to do.
+import assert from 'node:assert/strict';import fs from 'node:fs';import {gunzipSync} from 'node:zlib';
+import {M} from '../dist/duel.mjs';import {bookPick,BOOKS} from '../dist/ai/book/book.mjs';
+const db=JSON.parse(gunzipSync(fs.readFileSync('dist/cards.json.gz'))),code=n=>+Object.keys(db).find(k=>db[k].name===n);
+const KITT='Tri-Brigade Springans Kitt';
+const mk=(name,extra={})=>({code:code(name),controller:0,position:1,location:16,sequence:0,...extra});
+const view=({first=true}={})=>({active:0,phase:4,turn:2,order:first?[0,1]:[1,0],decks:[{id:'branded'},{id:'sky'}],db,name:c=>db[c]?.name||'',hint:509,
+ currentEffect:{code:code(KITT)},attempts:new Map(),prompt:null,key:c=>[c.code,c.controller,c.location,c.sequence,'0'].join(':'),zone:()=>[]});
+const pick=(offered,first)=>{const v=view({first});const m={type:M.SELECT_CARD,selects:offered.map((n,i)=>mk(n,{sequence:i}))};
+ const r=bookPick(v,0,m,{indicies:[offered.length-1]});return r?offered[r.response.indicies[0]]:offered.at(-1)};
+const GY=['Albion the Shrouded Dragon','Tri-Brigade Mercourier','Blazing Cartesia, the Virtuous','Incredible Ecclesia, the Virtuous','Fallen of the White Dragon','Guiding Quem, the Virtuous','Fallen of Albaz'];
+// 1 and 2: walk the whole order by removing the pick each time.
+const order=first=>{const left=[...GY],out=[];while(left.length){const p=pick(left,first);out.push(p);left.splice(left.indexOf(p),1)}return out};
+assert.deepEqual(order(true),['Fallen of Albaz','Guiding Quem, the Virtuous','Fallen of the White Dragon','Incredible Ecclesia, the Virtuous','Blazing Cartesia, the Virtuous','Tri-Brigade Mercourier','Albion the Shrouded Dragon'],'going-first order (Akiza)');
+assert.deepEqual(order(false),['Fallen of Albaz','Incredible Ecclesia, the Virtuous','Blazing Cartesia, the Virtuous','Guiding Quem, the Virtuous','Fallen of the White Dragon','Tri-Brigade Mercourier','Albion the Shrouded Dragon'],'going-second order: Ecclesia and Cartesia up');
+// 3: an offered Albaz Fusion comes first, either way.
+for(const first of [true,false])assert.equal(pick(['Fallen of Albaz','Guiding Quem, the Virtuous','Mirrorjade the Iceblade Dragon'],first),'Mirrorjade the Iceblade Dragon','Albaz Fusion first');
+// 4: the rules never name Kitt itself.
+const rules=BOOKS.branded.picks.filter(p=>p.source===KITT);assert.equal(rules.length,2);for(const r of rules){assert.ok(!r.prefer.includes(KITT),'never itself');assert.deepEqual(r.hint,[509])}
+// 5: nothing named offered -> base choice stands (bookPick returns null).
+assert.equal(bookPick(view(),0,{type:M.SELECT_CARD,selects:[mk('Aluber the Jester of Despia')]},{indicies:[0]}),null,'unnamed offer: base choice');
+// The old DARK Kitt search pick is gone; the materials picks already list the new Kitt (unchanged by this item).
+assert.ok(!BOOKS.branded.picks.some(p=>p.source==='Springans Kitt'),'old Kitt search pick removed');
+assert.ok(BOOKS.branded.picks.some(p=>p.source==='Branded Fusion'&&p.hint.includes(511)&&p.prefer.includes(KITT)),'Branded Fusion materials already name the new Kitt');
+console.log(JSON.stringify({test:'r35-kitt-revive',pass:true,node:process.version}));
