+const db=JSON.parse(gunzipSync(fs.readFileSync('dist/cards.json.gz'))),code=n=>+Object.keys(db).find(k=>db[k].name===n);
+const KITT=19304410,MJ='Mirrorjade the Iceblade Dragon',RIND='Rindbrumm the Striking Dragon',SANCT='Albion the Sanctifire Dragon',TITAN='Titaniklad the Ash Dragon',ALBA='Alba-Lenatus the Abyss Dragon',LUB='Lubellion the Searing Dragon',DOGMA='The Dragon that Devours the Dogma';
+const ALBAZ='Fallen of Albaz',QUEM='Guiding Quem, the Virtuous',WD='Fallen of the White Dragon',ECC='Incredible Ecclesia, the Virtuous',CART='Blazing Cartesia, the Virtuous',MERC='Tri-Brigade Mercourier',SHROUD='Albion the Shrouded Dragon';
+const card=(n,location=16,i=0)=>({code:code(n),controller:0,location,sequence:i,position:location===4?1:0});
+function view({first=true,field=[],extra=[LUB],hand=[],events=[],hint=509,effect=KITT,deck=['Fallen of Albaz','Dogmatika Fleurdelis, the Knighted','Branded Fusion','Tri-Brigade Mercourier'],gy=[],oppGy=[]}={}){const z={4:field.map((n,i)=>card(n,4,i)),64:extra.map((n,i)=>card(n,64,i)),2:hand.map((n,i)=>card(n,2,i)),1:deck.map((n,i)=>card(n,1,i)),16:gy.map((n,i)=>card(n,16,i))},zo={16:oppGy.map((n,i)=>({...card(n,16,i),controller:1}))};
+ return {active:0,phase:4,turn:3,order:first?[0,1]:[1,0],decks:[{id:'branded'},{id:'sky'}],db,name:c=>db[c]?.name||'',hint,currentEffect:{code:effect},attempts:new Map(),events:events.map((e,i)=>({id:i+1,...e})),prompt:null,
+  key:c=>[c.code,c.controller,c.location,c.sequence].join(':'),zone:(s,l)=>s===0?(z[l]||[]):(zo[l]||[])}}
+const pick=(offered,opts={},base=offered.length-1)=>{const v=view(opts);const m={type:M.SELECT_CARD,selects:offered.map((n,i)=>card(n,16,i))};const r=bookPick(v,0,m,{indicies:[base]});return r?offered[r.response.indicies[0]]:offered[base]};
+const walk=(offered,opts)=>{const left=[...offered],out=[];while(left.length){const p=pick(left,opts);out.push(p);left.splice(left.indexOf(p),1)}return out};
+const ALL=[LUB,ALBA,TITAN,SHROUD,MERC,CART,ECC,WD,QUEM,ALBAZ,SANCT,RIND,MJ];
+// 1-2. Full order (an Albaz Fusion left in the Extra Deck, no Mirrorjade controlled, nothing sent this turn).
+assert.deepEqual(walk(ALL,{first:true}),[MJ,RIND,SANCT,ALBAZ,QUEM,WD,ECC,CART,MERC,SHROUD,TITAN,ALBA,LUB],'going first: Akiza 07:05 order');
+assert.deepEqual(walk(ALL,{first:false}),[MJ,RIND,SANCT,ALBAZ,ECC,CART,QUEM,WD,MERC,SHROUD,TITAN,ALBA,LUB],'going second: Ecclesia and Cartesia move up');
+// 3. RELAY-054 counterexamples.
+assert.equal(pick([TITAN,RIND,ALBAZ]),RIND,'Rindbrumm precedes Titaniklad');
+assert.equal(pick([TITAN,ALBAZ],{},0),ALBAZ,'Titaniklad is a body below the Main Deck picks');
+// 4. Mirrorjade's conditions.
+assert.equal(pick([MJ,RIND],{field:[MJ]},0),RIND,'we already control a Mirrorjade: skip it');
+assert.equal(pick([MJ,RIND],{extra:[]},0),RIND,'no Albaz Fusion left in the Extra Deck (its cost): skip it');
+assert.equal(mirrorjadeLive(view({extra:['Garura, Wings of Resonant Life']}),0),false,'a Fusion that does not mention Albaz is no cost');
+assert.equal(pick([MJ,ALBAZ],{},1),MJ,'live Mirrorjade first');
+// 5. Never-rules: Titaniklad / Alba-Lenatus (and Dogma) sent to the GY this turn with the End Phase search unused.
+const sentThisTurn=n=>[{type:'turn'},{type:'move',code:code(n),to:{location:16,controller:0}}];
+assert.equal(pick([TITAN,LUB],{events:sentThisTurn(TITAN)},0),LUB,'never Titaniklad sent this turn with its search unused');
+assert.equal(pick([ALBA,LUB],{events:sentThisTurn(ALBA)},0),LUB,'never Alba-Lenatus sent this turn with its search unused');
+assert.equal(pick([TITAN,LUB],{events:[...sentThisTurn(TITAN),{type:'activate',player:0,code:code(TITAN),description:String(BigInt(code(TITAN))<<20n)}]},1),TITAN,'its End Phase search (effect 0) already used this turn: a body again, above Lubellion');
+assert.equal(pick([TITAN,LUB],{events:[{type:'move',code:code(TITAN),to:{location:16,controller:0}},{type:'turn'}]},1),TITAN,'sent on an earlier turn: allowed');
+assert.equal(pick([TITAN,DOGMA],{events:sentThisTurn(TITAN)},0),DOGMA,'a forbidden base choice is replaced by another offered card');
+assert.equal(pick([DOGMA,LUB],{events:sentThisTurn(DOGMA)},0),LUB,'Dogma has the same End Phase clause');
+assert.equal(epSearchPending(view({events:sentThisTurn(TITAN)}),0,code(TITAN)),true);
+// 6. Dogma (rev 4, Akiza via Seto 09:10): slot 4 if its shuffle (effect 0) is unused and any GY / banishment has a card.
+const D0=String(BigInt(code(DOGMA))<<20n);
+assert.equal(pick([DOGMA,ALBAZ],{gy:['Aluber the Jester of Despia']},1),DOGMA,'slot 4: above the Main Deck picks');
+assert.equal(pick([DOGMA,SANCT],{gy:['Aluber the Jester of Despia']},0),SANCT,'slot 4: below Sanctifire');
+assert.equal(pick([DOGMA,ALBAZ],{oppGy:['Ash Blossom & Joyous Spring']},1),DOGMA,'any GY counts, theirs too');
+assert.equal(pick([DOGMA,ALBAZ],{},0),ALBAZ,'no card in any GY or banishment: Dogma is a body');
+assert.equal(pick([DOGMA,ALBAZ],{gy:['Aluber the Jester of Despia'],events:[{type:'turn'},{type:'activate',player:0,code:code(DOGMA),description:D0}]},0),ALBAZ,'its shuffle already used this turn: a body');
+assert.equal(pick([DOGMA,TITAN],{gy:[ECC]},1),DOGMA,'Ecclesia in the GY also makes a GY card, so slot 4 applies');
+assert.equal(pick([DOGMA,TITAN],{field:[ECC],events:[{type:'turn'},{type:'activate',player:0,code:code(DOGMA),description:D0}]},1),DOGMA,'failed slot 4, Ecclesia on the field: first among the bodies');
+assert.equal(pick([DOGMA,LUB],{events:[{type:'turn'},{type:'activate',player:0,code:code(DOGMA),description:D0}]},0),LUB,'failed slot 4, no Ecclesia: after Lubellion');
+assert.ok(!kittReviveOrder(view(),0).includes('Tri-Brigade Springans Kitt'),'never Kitt itself');
+// 6b. Refined never-rule: only while a legal search target is still in our Deck.
+assert.equal(pick([TITAN,LUB],{events:sentThisTurn(TITAN),deck:['Branded Fusion']},1),TITAN,'Titaniklad: no Albaz / Dogmatika monster left to fetch: the never-rule does not apply');
+assert.equal(pick([ALBA,LUB],{events:sentThisTurn(ALBA),deck:['Fallen of Albaz']},1),ALBA,'Alba-Lenatus: no Polymerization / Fusion Normal Spell left: allowed');
+assert.equal(pick([ALBA,LUB],{events:sentThisTurn(ALBA),deck:['Super Polymerization']},1),ALBA,'Alba-Lenatus: Super Polymerization is a Quick-Play Spell, not a target: allowed');
+assert.equal(pick([ALBA,LUB],{events:sentThisTurn(ALBA),deck:['Branded Fusion']},0),LUB,'Alba-Lenatus: Branded Fusion (a Fusion Normal Spell) is a target: never');
+assert.equal(pick([DOGMA,LUB],{events:[{type:'turn'},{type:'move',code:code(DOGMA),to:{location:16,controller:0}},{type:'activate',player:0,code:code(DOGMA),description:D0}],deck:['Tri-Brigade Mercourier']},0),LUB,'Dogma: its SHUFFLE (effect 0) used does not count as its End Phase search (effect 1)');
+// 7. Not Kitt's revive: untouched (another source, or another hint).
+assert.equal(bookPick(view({effect:code('Branded Fusion')}),0,{type:M.SELECT_CARD,selects:[card(TITAN),card(RIND)]},{indicies:[0]}),null,'other source: no Kitt rule');
+// 8. K3-02: the Branded Fusion material lists no longer prefer Kitt; a base choice of Ecclesia over Kitt is preserved.
+for(const r of BOOKS.branded.picks.filter(p=>p.source==='Branded Fusion'&&p.hint.includes(511)))assert.ok(!r.prefer.includes('Tri-Brigade Springans Kitt'),'Kitt is not a forced material preference');
+{const v=view({hand:[ALBAZ],hint:511,effect:code('Branded Fusion')});const m={type:M.SELECT_UNSELECT_CARD,selects:[card('Tri-Brigade Springans Kitt',1,0),card(ECC,1,1)]};
+ const r=bookPick(v,0,m,{index:1});assert.ok(r===null||r.response.index===1,'K3-02: base Ecclesia is kept over Kitt (Albaz in hand)');
+ const r2=bookPick(v,0,m,{index:0});assert.ok(r2===null||r2.response.index===0,'K3-02 mirror: a base pick of Kitt is not blocked or replaced');}
+console.log(JSON.stringify({test:'r35-kitt-revive',rev:5,pass:true,node:process.version}));
diff --git a/tests/r35-turn-ledger.test.mjs b/tests/r35-turn-ledger.test.mjs
new file mode 100644
index 0000000..4b72772
--- /dev/null
+++ b/tests/r35-turn-ledger.test.mjs
@@ -0,0 +1,58 @@
+// r35 rollover fix (Claude, 28 Oct 2026; RELAY-056 / RELAY-057). SELF-VERIFIED (builder = verifier), NOT independent.
+// The durable turn ledger (dist/ai/book/turn-ledger.mjs) and the Kitt revive checks built on it, against the duel's REAL
+// event() method (Duel.prototype.event: push with id, keep the last 120). No engine: a plain object stands in for the duel,
+// and AI views are Object.create(duel) exactly as safeView / the pilot shadow build them.
+import assert from 'node:assert/strict';import fs from 'node:fs';import {gunzipSync} from 'node:zlib';
+import {Duel} from '../dist/duel.mjs';import {turnLedger} from '../dist/ai/book/turn-ledger.mjs';
+import {sentToGyThisTurn,activatedThisTurn,epSearchPending,dogmaSlot4} from '../dist/ai/book/kitt-revive.mjs';
+const db=JSON.parse(gunzipSync(fs.readFileSync('dist/cards.json.gz'))),code=n=>+Object.keys(db).find(k=>db[k].name===n);
+const TITAN=code('Titaniklad the Ash Dragon'),DOGMA=code('The Dragon that Devours the Dogma'),ALBAZ=code('Fallen of Albaz');
+const ev=Duel.prototype.event;
+function duel(){const z={1:[{code:ALBAZ,controller:0,location:1,sequence:0}],16:[{code:ALBAZ,controller:0,location:16,sequence:0}]};
+ return {events:[],eventSeq:0,db,name:c=>db[c]?.name||'',zone:(s,l)=>s===0?(z[l]||[]):[],event:ev}}
+const view=d=>Object.create(d);/* as safeView */
+const sendTitan=d=>d.event('move',{code:TITAN,from:{location:4,controller:0},to:{location:16,controller:0}});
+const filler=(d,n)=>{for(let i=0;i<n;i++)d.event('hint',{text:'filler '+i})};
+const dogma0=d=>d.event('activate',{player:0,code:DOGMA,description:String(BigInt(DOGMA)<<20n)});
+// 1. Duel.event really keeps only 120 (the bug this fixes).
+{const d=duel();d.event('turn',{turn:1});sendTitan(d);filler(d,130);assert.equal(d.events.length,120);assert.ok(!d.events.some(e=>e.type==='move'),'the send rolled out of the window')}
+// 2. Observed, then rolled out: the ledger remembers (old code forgot and would revive Titaniklad).
+{const d=duel();d.event('turn',{turn:1});sendTitan(d);assert.equal(sentToGyThisTurn(view(d),0,TITAN),true);
+ for(let k=0;k<13;k++){filler(d,10);turnLedger(view(d))}/* the AI reads between batches */
+ assert.ok(!d.events.some(e=>e.type==='move'));const L=turnLedger(view(d));assert.equal(L.complete,true,'no gap: every event was seen');
+ assert.equal(sentToGyThisTurn(view(d),0,TITAN),true,'still known after rollover');assert.equal(epSearchPending(view(d),0,TITAN),true,'never revive it')}
+// 3. Never observed before rolling out: UNKNOWN, treated conservatively.
+{const d=duel();d.event('turn',{turn:1});sendTitan(d);dogma0(d);filler(d,130);
+ assert.equal(turnLedger(view(d)).complete,false);assert.equal(sentToGyThisTurn(view(d),0,TITAN),null,'unknown, not false');
+ assert.equal(epSearchPending(view(d),0,TITAN),true,'unknown = search pending (do not revive)');
+ assert.equal(activatedThisTurn(view(d),0,DOGMA,0),null);assert.equal(dogmaSlot4(view(d),0,DOGMA),false,'unknown = shuffle used (no slot 4)');
+ // 3b. The next turn starts a complete record again.
+ d.event('turn',{turn:2});assert.equal(turnLedger(view(d)).complete,true);assert.equal(sentToGyThisTurn(view(d),0,TITAN),false);
+ assert.equal(epSearchPending(view(d),0,TITAN),false);assert.equal(dogmaSlot4(view(d),0,DOGMA),true,'a GY card and an unused shuffle')}
+// 4. Rollover of an ACTIVATION that was observed: the used search stays used.
+{const d=duel();d.event('turn',{turn:1});sendTitan(d);d.event('activate',{player:0,code:TITAN,description:String(BigInt(TITAN)<<20n)});turnLedger(view(d));
+ for(let k=0;k<13;k++){filler(d,10);turnLedger(view(d))}
+ assert.equal(activatedThisTurn(view(d),0,TITAN,0),true);assert.equal(epSearchPending(view(d),0,TITAN),false,'search used: a body again')}
+// 5. Two effects of one card: Dogma's shuffle (0) used is not its End Phase search (1).
+{const d=duel();d.event('turn',{turn:1});dogma0(d);
+ assert.equal(activatedThisTurn(view(d),0,DOGMA,0),true);assert.equal(activatedThisTurn(view(d),0,DOGMA,1),false);assert.equal(activatedThisTurn(view(d),0,DOGMA),true,'any index')}
+// 6. Retry: the duel filters out the rejected 'effectChosen' into a NEW array (duel.mjs respond). Same history: no false gap.
+{const d=duel();d.event('turn',{turn:1});sendTitan(d);turnLedger(view(d));
