+// r35.12 (Seto, 30 Oct 2026): render the coin / dice scene sounds to WAV previews for review (tooling only; the game never
+// loads this). Runs the REAL CoinScene.show() timeline and coinSound() cues against a small offline renderer that follows
+// the Soundscape tone() / noise() envelopes (exponential frequency glide, fast attack, exponential decay; band-passed noise).
+// Levels: SFX bus 0.8 x master 0.5 (the defaults), no compressor. Usage: node tools/r35.12-render-coin-dice-sfx.mjs <outdir> [dist]
+import fs from 'node:fs';import path from 'node:path';import {pathToFileURL} from 'node:url';
+const out=process.argv[2]||'.',dist=process.argv[3]||new URL('../dist/',import.meta.url).pathname;
+const {CoinScene,COIN_MS}=await import(pathToFileURL(path.join(dist,'coin-cutscene.mjs')).href);
+const SR=44100;
+function renderer(seconds){const buf=new Float32Array(Math.ceil(seconds*SR));let seed=12345;const rnd=()=>{seed=(seed*1103515245+12345)&0x7fffffff;return seed/0x7fffffff*2-1};
