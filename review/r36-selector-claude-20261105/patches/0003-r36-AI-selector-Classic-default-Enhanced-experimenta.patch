+// r36 AI selector browser check (Claude, Nov 2026; RELAY-105 browser coverage). Serves nothing itself: pass the URL of a
+// served dist/. Chromium via the pre-installed Playwright. For each device (desktop, tablet portrait, tablet landscape):
+//  - cold load: #ai-mode is Classic and visible;
+//  - Watch duel in Classic: the match banner says "AI Classic";
+//  - switching the select to Enhanced mid-duel does NOT change the running duel (banner still Classic after 4 s);
+//  - New duel: banner says "AI Enhanced (experimental)", and the duel runs to turn >= T (or the end) with no page errors;
+//  - reload: the select is Classic again (nothing stored);
+//  - Play mode in Enhanced starts (the hidden banner text records the mode) with no page errors.
+// Usage: node tools/r36-ai-mode-browser.mjs <url> <outdir> [minTurn=5] [minutes=6]
+import {createRequire} from 'node:module';import fs from 'node:fs';const require=createRequire(import.meta.url);
+const {chromium,devices}=require('/opt/npm-tools/node_modules/playwright');
+const [url,out,minTurn='5',mins='6']=process.argv.slice(2);fs.mkdirSync(out,{recursive:true});
+const DEV={desktop:{viewport:{width:1366,height:900}},tabletPortrait:devices['Galaxy Tab S4'],tabletLandscape:devices['Galaxy Tab S4 landscape']};
+const browser=await chromium.launch();const report={url,minTurn:+minTurn,devices:{}};
+const ready=p=>p.waitForFunction(()=>document.querySelector('#start')&&!document.querySelector('#start').disabled,null,{timeout:120000});
+const start=(p,mode,ai,seed)=>p.evaluate(([mode,ai,seed])=>{const $=s=>document.querySelector(s);$('#deck-a').value='branded';$('#deck-a').dispatchEvent(new Event('change'));$('#deck-b').value='sky';$('#deck-b').dispatchEvent(new Event('change'));$('#mode').value=mode;$('#mode').dispatchEvent(new Event('change'));$('#ai-mode').value=ai;$('#ai-mode').dispatchEvent(new Event('change'));$('#game-seed').value=seed;$('#first').value='0';$('#start').click()},[mode,ai,seed]);
+const banner=p=>p.evaluate(()=>document.querySelector('#match-study')?.textContent||'');
+const turn=p=>p.evaluate(()=>{const t=document.querySelector('#turn-label')?.textContent||'';const m=t.match(/(\d+)/);return {text:t,n:m?+m[1]:0,title:document.querySelector('#decision-title')?.textContent||''}});
+const toNew=async p=>{const b=await p.$('#new');if(b&&await b.isVisible())await b.click();else await p.evaluate(()=>document.querySelector('#new')?.click());await ready(p)};
+for(const [name,dev] of Object.entries(DEV)){const ctx=await browser.newContext({...dev});const p=await ctx.newPage();const errors=[];p.on('pageerror',e=>errors.push(e.message));p.on('console',m=>{if(m.type()==='error')errors.push(m.text())});
+ const R=report.devices[name]={};
+ try{await p.goto(url);await ready(p);
+  R.cold=await p.evaluate(()=>{const s=document.querySelector('#ai-mode');const r=s?.getBoundingClientRect();return {value:s?.value,visible:!!r&&r.width>0&&r.height>0,options:[...(s?.options||[])].map(o=>o.textContent)}});
+  await start(p,'watch','classic','71001');await p.waitForFunction(()=>/AI /.test(document.querySelector('#match-study')?.textContent||''),null,{timeout:60000});
+  R.classicBanner=(await banner(p)).match(/AI [A-Za-z ()]+$/)?.[0]||await banner(p);
+  await p.evaluate(()=>{const s=document.querySelector('#ai-mode');s.value='enhanced';s.dispatchEvent(new Event('change'))});await p.waitForTimeout(4000);
+  R.afterMidDuelSwitch=(await banner(p)).match(/AI [A-Za-z ()]+$/)?.[0];R.classicTurn=await turn(p);
+  await toNew(p);await start(p,'watch','enhanced','71002');await p.waitForFunction(()=>/AI Enhanced/.test(document.querySelector('#match-study')?.textContent||''),null,{timeout:60000});
+  R.enhancedBanner=(await banner(p)).match(/AI [A-Za-z ()]+$/)?.[0];
+  const end=Date.now()+(+mins)*60000;let t;while(Date.now()<end){t=await turn(p);if(t.n>=+minTurn||/wins|victory|complete|draw/i.test(t.title))break;await p.waitForTimeout(1000)}
+  R.enhancedReached=t;await p.screenshot({path:`${out}/${name}-enhanced.png`});
+  await p.reload();await ready(p);R.afterReload=await p.evaluate(()=>document.querySelector('#ai-mode')?.value);
+  await start(p,'play','enhanced','71003');await p.waitForFunction(()=>/AI Enhanced/.test(document.querySelector('#match-study')?.textContent||''),null,{timeout:60000});await p.waitForTimeout(5000);
+  R.playBanner=(await banner(p)).match(/AI [A-Za-z ()]+$/)?.[0];R.playBannerHidden=await p.evaluate(()=>document.querySelector('#match-study')?.hidden);await p.screenshot({path:`${out}/${name}-play.png`});
+ }catch(e){R.error=e.message.split('\n')[0]}
+ R.errors=errors.slice(0,10);await ctx.close()}
+await browser.close();fs.writeFileSync(out+'/report.json',JSON.stringify(report,null,1));console.log(JSON.stringify(report,null,1));
