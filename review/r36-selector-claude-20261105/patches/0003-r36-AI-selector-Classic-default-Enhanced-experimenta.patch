+// r36 AI selector: Classic parity fixture (Claude, Nov 2026; RELAY-105 "Classic parity pinned to r35.12 with parity
+// fixtures"). Plays one dev-seed duel with both seats' pilots from tree T and prints the full response-stream hash.
+// --mode classic|enhanced uses that tree's setAiMode (a tree without it, e.g. r35.12, must be run with --mode none).
+// --search N: search ON with node budget N and NO clock (shouldStop never fires), world pool on, so the run is
+// deterministic on any host; --search 0 = search off. Run once on the r35.12 tree and once on the candidate in Classic;
+// the stream hashes must be equal. Dev seeds 71001-71100 only.
+// Usage: node tools/r36-classic-parity.mjs --tree T --mode classic --a branded --b sky --seed 71001 --first 0 --search 400 [--max-turn 12]
+import fs from 'node:fs';import zlib from 'node:zlib';import path from 'node:path';import crypto from 'node:crypto';import {pathToFileURL} from 'node:url';
+const arg=(k,v)=>{const i=process.argv.indexOf('--'+k);return i>0?process.argv[i+1]:v};
+const T=path.resolve(arg('tree')),mode=arg('mode','classic'),seed=+arg('seed',71001),first=+arg('first',0),A=arg('a'),B=arg('b'),maxTurn=+arg('max-turn',12),nodes=+arg('search',0);
+if(!(seed>=71001&&seed<=71100))throw Error('dev seeds 71001-71100 only');
+const imp=f=>import(pathToFileURL(path.join(T,'dist',f)).href),sha=s=>crypto.createHash('sha256').update(s).digest('hex');
+if(mode!=='none'){const {setAiMode}=await imp('ai/midgame-flags.mjs');setAiMode(mode)}
+const {Duel}=await imp('duel.mjs'),{createOptimalPilots}=await imp('optimal-pilot.mjs'),{createSearchCore}=await imp('ai/engine-snapshot.mjs');
+const db=JSON.parse(zlib.gunzipSync(fs.readFileSync(T+'/dist/cards.json.gz'))),scripts=JSON.parse(zlib.gunzipSync(fs.readFileSync(T+'/dist/scripts.json.gz')));
+const all=JSON.parse(fs.readFileSync(T+'/dist/decks.json')).decks.map(d=>d.banlistVariants?.['tcg-2026-10-19']?{...d,...d.banlistVariants['tcg-2026-10-19']}:d);
+const d=await Duel.create(db,scripts);
+const ps=nodes>0?[0,1].map(s=>null):createOptimalPilots({seed,searchEnabled:false});
+if(nodes>0)for(const s of [0,1]){const core=await createSearchCore(db,scripts);ps[s]=createOptimalPilots({seed,nodeBudget:nodes,searchCore:core,worldPool:true,poolKey:'parity:'+seed+':'+s,poolSize:10,seatCapBytes:40*1048576,shouldStop:()=>false})[s]}
+const stream=[];let n=0,err=null;const t0=Date.now();
+try{d.start([all.find(x=>x.id===A),all.find(x=>x.id===B)],{seed,first});
+ while(d.prompt&&!d.finished&&n<6000&&d.turn<=maxTurn){const s=d.prompt.seat,plan=ps[s].plan(d);if(!plan?.response)break;stream.push(JSON.stringify(plan.response));d.respond(plan.response);for(const p of ps)p.observe?.(plan);n++}}catch(e){err=String(e?.message||e)}
+console.log(JSON.stringify({tree:T,mode,search:nodes,seed,first,decks:[A,B],maxTurn,winner:d.finished?d.winner:null,turns:d.turn,lp:d.lp,decisions:n,errors:[...(d.errors||[]),...(err?[err]:[])],streamSha256:sha(stream.join('\n')),wallMs:Date.now()-t0}));
+try{d.stop()}catch{}process.exit(0);
