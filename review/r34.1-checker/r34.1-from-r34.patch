diff --git a/tools/r34-render-chain-sfx.py b/tools/r34-render-chain-sfx.py
new file mode 100644
index 0000000..e461031
--- /dev/null
+++ b/tools/r34-render-chain-sfx.py
@@ -0,0 +1,56 @@
+#!/usr/bin/env python3
+# r34.1 chain sounds (Claude, 23 Oct 2026; Kevy 20:00: "the gong sound when chain links happen is actually immersion
+# breaking ... it needs to be pleasant ... vibrant or crisp. The actual chain rustling sound is great").
+# Replaces chain-1..4, chain-lock and chain-resolve from tools/r28-render-sfx.py. The low inharmonic metal partials with
+# long decays + sub boom + heavy saturation (the "gong") are gone. Each link is now:
+#   - the CC0 chain rattle Kevy liked (BigSoundBank 0359, see dist/audio/CREDITS.md), slightly forward in the mix,
+#   - a short crisp high "clink" (bright metal partials, ~70 ms decay: no ring),
+#   - a clean bell chime with harmonic partials, rising one step per link on a major pentatonic (E5 G5 A5 C6),
+#   - a light, short body thump instead of the long boom; little reverb, gentle saturation.
+# Chain lock = rising two-note chime + rattle; resolve = soft falling chime + light rattle.
+# Original sounds (no Konami / Master Duel audio). Deterministic. Same helper functions as r28 (executed from that file).
+# Usage: python3 tools/r34-render-chain-sfx.py <chain.wav 44.1 kHz mono decode of dist/audio/heavy-chain.mp3> <out dir>
+import sys, os, json, subprocess
+HERE = os.path.dirname(os.path.abspath(__file__))
+src = open(os.path.join(HERE, 'r28-render-sfx.py')).read()
+exec(src[: src.index('S = {}')])  # helpers + the chain recording (rattle); sys.argv is read there
+
+def bell(f, d=1.2, dec=0.35, partials=((1, 1.0), (2, 0.42), (3, 0.2), (4.0, 0.12), (5.0, 0.05))):
+    # harmonic (in-tune) bell / chime: pleasant, no gong-like inharmonic beating
+    t = t_(d); out = np.zeros(len(t))
+    for r, g in partials:
+        fr = f * r
+        if fr > SR / 2.2: continue
+        out += g * np.sin(2 * np.pi * fr * t) * np.exp(-t / (dec / (1 + 0.8 * (r - 1))))
+    return endfade(out * env(len(t), 0.0015, 10), 0.2)
+
+def clink(f=2400, d=0.25):
+    return mix(metal(f, d, 0.07, 0.75) * 0.8, crack(0.025, 3500, 14000) * 0.9)
+
+def thump(d=0.22): return boom(150, 70, d, 0.05)
+
+S = {}
+notes = [659.25, 783.99, 880.0, 1046.5]  # E5 G5 A5 C6
+for n in range(1, 5):
+    f = notes[n - 1]
+    rat = mix(rattle(2.18, 0.75, 1 + 0.04 * (n - 1), 0.75 + 0.05 * n), at(rattle(1.02, 0.5, 1.1 + 0.05 * n, 0.35), 0.1) if n >= 2 else np.zeros(1))
+    chime = mix(bell(f, 1.1, 0.32 + 0.04 * n) * 0.55, at(bell(f * 1.5, 0.9, 0.22) * 0.18, 0.012))
+    if n >= 3: chime = mix(chime, at(bell(f * 2, 0.8, 0.2) * 0.15, 0.03))
+    x = mix(clink(2300 + 120 * n) * 0.7, at(chime, 0.008), thump() * 0.45, at(rat, 0.015))
+    S[f'chain-{n}'] = sat(norm(verb(x, 0.14 + 0.02 * n, 0.8 + 0.1 * n, 7500), 0.93), 1.15)
+S['chain-lock'] = sat(norm(verb(mix(clink(2600) * 0.8, at(bell(880, 1.4, 0.4) * 0.5, 0.01), at(bell(1318.5, 1.6, 0.5) * 0.5, 0.11),
+                                   at(bell(1760, 1.4, 0.4) * 0.2, 0.12), thump(0.3) * 0.6, at(rattle(2.18, 0.9, 0.95, 0.9), 0.02)), 0.22, 1.4, 7500), 0.93), 1.15)
+S['chain-resolve'] = sat(norm(verb(mix(at(bell(1046.5, 0.9, 0.22) * 0.45, 0.0), at(bell(783.99, 0.9, 0.24) * 0.4, 0.07),
+                                      at(rattle(2.25, 0.5, 0.97, 0.55), 0.02), clink(1900, 0.2) * 0.4, thump(0.2) * 0.35), 0.16, 1.0, 7000), 0.9), 1.1)
+
+manifest = json.load(open(os.path.join(OUT, 'sfx.json'))) if os.path.exists(os.path.join(OUT, 'sfx.json')) else {'sounds': {}}
+for name, x in S.items():
+    x = norm(fade_tail(trim(x)), 0.84)
+    wav = os.path.join(OUT, name + '.wav'); mp3 = os.path.join(OUT, name + '.mp3')
+    wavfile.write(wav, SR, (np.clip(x, -1, 1) * 32767).astype(np.int16))
+    subprocess.run(['ffmpeg', '-v', 'error', '-y', '-i', wav, '-codec:a', 'libmp3lame', '-b:a', '128k', '-map_metadata', '-1', mp3], check=True)
+    os.remove(wav); manifest['sounds'][name] = {'file': name + '.mp3', 'seconds': round(len(x) / SR, 2)}
+manifest['version'] = 'r34.1'
+manifest['note'] = 'Original rendered SFX (tools/r28-render-sfx.py; chain-1..4, chain-lock, chain-resolve re-rendered by tools/r34-render-chain-sfx.py). Chain layers use the CC0 BigSoundBank 0359 recording.'
+json.dump(manifest, open(os.path.join(OUT, 'sfx.json'), 'w'), indent=1)
+print(json.dumps({k: manifest['sounds'][k] for k in S}))
diff --git a/tools/r34-render-hyoshigi-sfx.py b/tools/r34-render-hyoshigi-sfx.py
new file mode 100644
index 0000000..1bfdcd5
--- /dev/null
+++ b/tools/r34-render-hyoshigi-sfx.py
@@ -0,0 +1,61 @@
+#!/usr/bin/env python3
+# r34.1 chain sounds, hyoshigi version (Claude, 23 Oct 2026; Kevy 20:09: "I want like Japanese Hyoshigi sound").
+# Hyoshigi are the two hardwood clappers struck together in kabuki and sumo: a dry, bright, resonant "kan!" with a short
+# wooden ring, and at big moments an accelerating roll (kizami) that ends on a hard double strike.
+# Built by modal synthesis (no recordings of real hyoshigi): a very short impulse drives a few damped wood modes
+# (free-bar ratios 1, 2.76, 5.40 + a body mode), the two sticks give a tiny flam, and a small wooden hall adds space.
+# The chain rattle Kevy liked (CC0 BigSoundBank 0359, see dist/audio/CREDITS.md) stays underneath, softer.
+#   chain-1..4: one strike per link, each link a little higher and harder (link 3+ adds a second strike: "kan-kan").
+#   chain-lock: the kabuki roll (strikes speeding up) ending on a hard double strike.
+#   chain-resolve: one soft, lower strike.
+# Original sounds; no Konami / Master Duel audio. Deterministic. Helpers are executed from tools/r28-render-sfx.py.
+# Usage: python3 tools/r34-render-hyoshigi-sfx.py <chain.wav 44.1 kHz mono decode of dist/audio/heavy-chain.mp3> <out dir>
+import sys, os, json, subprocess
+HERE = os.path.dirname(os.path.abspath(__file__))
+src = open(os.path.join(HERE, 'r28-render-sfx.py')).read()
+exec(src[: src.index('S = {}')])
+
+def wood(f=1250, d=0.5, dec=0.07, hard=1.0):
+    # one hardwood strike: damped modes, phase-aligned at the hit, plus the contact click
+    t = t_(d); out = np.zeros(len(t))
+    for r, g, k in ((1.0, 1.0, 1.0), (2.76, 0.55 * hard, 0.55), (5.40, 0.28 * hard, 0.35), (0.48, 0.35, 1.6)):
+        fr = f * r * (1 + rng.uniform(-0.004, 0.004))
+        if fr > SR / 2.2: continue
+        out += g * np.sin(2 * np.pi * fr * t) * np.exp(-t / (dec * k))
+    click = bp(noise(0.006), 2000, 12000) * env(int(0.006 * SR), 0.0002, 0.0012) * 1.6 * hard
+    return endfade(mix(out * env(len(t), 0.0004, 10), click), 0.15)
+
+def strike(f, hard=1.0, flam=0.006):
+    # the two sticks meet: main strike + a slightly detuned partner a few ms later
+    return mix(wood(f, 0.5, 0.075 + 0.02 * hard, hard), at(wood(f * 1.035, 0.45, 0.06, hard * 0.8) * 0.55, flam))
+
+def hall(x, wet=0.26, length=1.3): return verb(x, wet, length, 6500, 0.012)
+
+S = {}
+base = [1180, 1250, 1325, 1400]
+for n in range(1, 5):
+    f = base[n - 1]; h = 0.85 + 0.08 * n
+    hits = strike(f, h)
+    if n >= 3: hits = mix(hits, at(strike(f * 1.06, h * 0.9), 0.17))
+    if n >= 4: hits = mix(hits, at(strike(f * 1.12, h), 0.30))
+    rat = rattle(2.18, 0.7, 1 + 0.04 * (n - 1), 0.3 + 0.04 * n)
+    S[f'chain-{n}'] = sat(norm(hall(mix(hits, at(rat, 0.03))), 0.93), 1.1)
+# kabuki roll: gaps shrink from 0.16 s to 0.035 s, getting louder, then a hard double strike
+t = 0.0; roll = []; gap = 0.16; i = 0
+while gap > 0.034:
+    roll.append(at(strike(1300 + 6 * i, 0.55 + 0.03 * i) * (0.45 + 0.035 * i), t)); t += gap; gap *= 0.84; i += 1
+roll.append(at(strike(1380, 1.25) * 1.15, t + 0.09)); roll.append(at(strike(1420, 1.3) * 1.2, t + 0.27))
+S['chain-lock'] = sat(norm(hall(mix(*roll, at(rattle(2.18, 0.9, 0.95, 0.4), t + 0.1)), 0.3, 1.6), 0.93), 1.1)
+S['chain-resolve'] = sat(norm(hall(mix(strike(1050, 0.7) * 0.8, at(rattle(2.25, 0.5, 0.97, 0.3), 0.02)), 0.22, 1.1), 0.9), 1.05)
+
+manifest = json.load(open(os.path.join(OUT, 'sfx.json'))) if os.path.exists(os.path.join(OUT, 'sfx.json')) else {'sounds': {}}
+for name, x in S.items():
+    x = norm(fade_tail(trim(x)), 0.84)
+    wav = os.path.join(OUT, name + '.wav'); mp3 = os.path.join(OUT, name + '.mp3')
+    wavfile.write(wav, SR, (np.clip(x, -1, 1) * 32767).astype(np.int16))
+    subprocess.run(['ffmpeg', '-v', 'error', '-y', '-i', wav, '-codec:a', 'libmp3lame', '-b:a', '128k', '-map_metadata', '-1', mp3], check=True)
+    os.remove(wav); manifest['sounds'][name] = {'file': name + '.mp3', 'seconds': round(len(x) / SR, 2)}
+manifest['version'] = 'r34.1'
+manifest['note'] = 'Original rendered SFX (tools/r28-render-sfx.py; chain-1..4, chain-lock, chain-resolve re-rendered as hyoshigi wood strikes by tools/r34-render-hyoshigi-sfx.py). Chain rattle layer uses the CC0 BigSoundBank 0359 recording.'
+json.dump(manifest, open(os.path.join(OUT, 'sfx.json'), 'w'), indent=1)
+print(json.dumps({k: manifest['sounds'][k] for k in S}))
diff --git a/tools/r34-render-taiko-sfx.py b/tools/r34-render-taiko-sfx.py
new file mode 100644
index 0000000..f67a0f0
--- /dev/null
+++ b/tools/r34-render-taiko-sfx.py
@@ -0,0 +1,61 @@
+#!/usr/bin/env python3
+# r34.1 chain sounds, taiko version (Claude, 23 Oct 2026; Kevy 20:12: "What about a Taiko drum sound? ... I'll compare
+# the two" — the other is tools/r34-render-hyoshigi-sfx.py).
+# Taiko: a big barrel drum. "DON" = the stick on the skin (deep pitched boom that drops in pitch, skin slap, shell ring);
+# "KA" = the stick on the wooden rim (short dry click). Built by modal synthesis (circular-membrane mode ratios), no
+# recordings of real taiko. The chain rattle (CC0 BigSoundBank 0359, see dist/audio/CREDITS.md) stays underneath, soft.
+#   chain-1..4: one DON per link, each a little higher and harder; link 3 = DON-DON, link 4 = DON-ka-DON.
+#   chain-lock: a roll that speeds up and ends on a huge DON plus a rim KA.
+#   chain-resolve: rim KA then a soft don.
+# Original sounds; no Konami / Master Duel audio. Deterministic. Helpers are executed from tools/r28-render-sfx.py.
+# Usage: python3 tools/r34-render-taiko-sfx.py <chain.wav 44.1 kHz mono decode of dist/audio/heavy-chain.mp3> <out dir>
+import sys, os, json, subprocess
+HERE = os.path.dirname(os.path.abspath(__file__))
+src = open(os.path.join(HERE, 'r28-render-sfx.py')).read()
+exec(src[: src.index('S = {}')])
+
+def don(f=78, d=1.6, dec=0.55, hard=1.0):
+    t = t_(d); out = np.zeros(len(t))
+    bend = 1 + 0.35 * hard * np.exp(-t / 0.035)  # the skin is tighter at the moment of the hit
+    for r, g, k in ((1.0, 1.0, 1.0), (1.59, 0.45, 0.6), (2.14, 0.28, 0.45), (2.30, 0.2, 0.4), (2.65, 0.14, 0.35)):
+        ph = 2 * np.pi * np.cumsum(f * r * bend) / SR
+        out += g * np.sin(ph) * np.exp(-t / (dec * k))
+    slap = lp(noise(0.05), 2200) * env(int(0.05 * SR), 0.0005, 0.012) * 0.9 * hard
+    stick = bp(noise(0.008), 1500, 7000) * env(int(0.008 * SR), 0.0002, 0.002) * 0.6 * hard
+    return endfade(mix(out * env(len(t), 0.001, 10), slap, stick), 0.3)
+
+def ka(f=1650, hard=1.0):
+    t = t_(0.25); out = np.zeros(len(t))
+    for r, g, k in ((1.0, 1.0, 1.0), (2.76, 0.5, 0.5), (5.4, 0.25, 0.3)):
+        out += g * np.sin(2 * np.pi * f * r * t) * np.exp(-t / (0.04 * k))
+    click = bp(noise(0.005), 2500, 12000) * env(int(0.005 * SR), 0.0002, 0.001) * 1.5
+    return endfade(mix(out * env(len(t), 0.0003, 10), click) * hard, 0.08)
+
+def hall(x, wet=0.32, length=1.8): return verb(x, wet, length, 5000, 0.02)
