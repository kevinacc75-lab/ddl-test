+#!/usr/bin/env python3
+# r34.1 chain-sound candidates, round 2 (Claude, 23 Oct 2026; Kevy 20:16: taiko "isn't it"; the hyoshigi "sounds more like
+# a xylophone ... any other variant?"). The first hyoshigi had clean, in-tune modes ringing ~80 ms: that pitch is the
+# xylophone. These styles are mostly noise and very short, so they read as a CRACK / SLAP, not a note:
+#   hyoshigi-dry : two hardwood blocks clapped: a dense cluster of short, slightly out-of-tune wood modes (~25 ms) +
+#                  a hard click + a hollow knock, flammed by 3 ms, in a big theatre room (the echo is half the sound).
+#   tsuke        : the kabuki stage clappers beaten on a wooden board ("ba-TAN!"): a board thud + wood crack, two beats.
+#   card-slap    : a card slammed on the table: a short whoosh into a sharp paper/card slap and a table knock.
+# Each: chain-1..4 grow (link 3+ doubles), chain-lock = a speeding roll ending on a big hit, chain-resolve = one soft hit.
+# The chain rattle Kevy liked (CC0 BigSoundBank 0359, see dist/audio/CREDITS.md) stays underneath, soft.
+# Original sounds; no recordings of real instruments, no Konami / Master Duel audio. Deterministic.
+# Usage: python3 tools/r34-render-wood-sfx.py <chain.wav> <out dir> <style>
+import sys, os, json, subprocess
+HERE = os.path.dirname(os.path.abspath(__file__))
+STYLE = sys.argv[3]
+src = open(os.path.join(HERE, 'r28-render-sfx.py')).read()
+exec(src[: src.index('S = {}')])
+
+def modes(f, ratios, dec, d=0.25):
+    t = t_(d); out = np.zeros(len(t))
+    for i, r in enumerate(ratios):
+        fr = f * r * (1 + rng.uniform(-0.03, 0.03))
+        if fr < SR / 2.2: out += np.sin(2 * np.pi * fr * t) * np.exp(-t / (dec * (1 - 0.08 * i))) / (1 + 0.25 * i)
+    return out * env(len(t), 0.0003, 10)
+
+def burst(d, lo, hi, dec, a=0.0002): x = bp(noise(d), lo, hi); return x * env(len(x), a, dec)
+
+def hit(style, power=1.0, pitch=1.0):
+    if style == 'hyoshigi-dry':
+        one = lambda f: mix(burst(0.02, 1500, 11000, 0.0025) * 1.6, modes(f, (1, 1.17, 1.43, 1.9, 2.35, 2.9, 3.6), 0.024) * 0.9,
+                            burst(0.06, f * 0.7, f * 1.4, 0.016) * 0.8)
+        f = 1450 * pitch
+        return mix(one(f), at(one(f * 1.05) * 0.7, 0.003)) * power
+    if style == 'tsuke':
+        return mix(burst(0.15, 110, 700, 0.04, 0.0006) * 1.5, modes(190 * pitch, (1, 1.6, 2.3), 0.05, 0.3) * 0.7,
+                   burst(0.015, 1800, 9000, 0.003) * 1.2, modes(900 * pitch, (1, 1.3, 1.75, 2.4), 0.018) * 0.5) * power
+    if style == 'card-slap':
+        whoosh = swept_noise(0.16, 700, 4500 * pitch, 1.6, 0.12, None) * 0.35
+        slap = mix(burst(0.05, 500, 7000, 0.009) * 1.7, burst(0.1, 80, 400, 0.03, 0.001) * 1.0, burst(0.01, 4000, 14000, 0.002) * 0.6)
+        return mix(whoosh, at(slap, 0.16)) * power
+    raise SystemExit('unknown style ' + style)
+
+LEAD = 0.16 if STYLE == 'card-slap' else 0.0
+ROOM = {'hyoshigi-dry': (0.42, 2.2), 'tsuke': (0.3, 1.6), 'card-slap': (0.18, 1.0)}[STYLE]
+def room(x, extra=0.0): return verb(x, ROOM[0] + extra, ROOM[1], 7000, 0.015)
+
+S = {}
+for n in range(1, 5):
+    p = 0.8 + 0.1 * n; pitch = 1 + 0.04 * (n - 1)
+    x = hit(STYLE, p, pitch)
+    if n >= 3: x = mix(x, at(hit(STYLE, p * 0.9, pitch * 1.03), 0.16 if STYLE != 'card-slap' else 0.12))
+    if n >= 4: x = mix(x, at(hit(STYLE, p * 1.05, pitch * 1.06), 0.30 if STYLE != 'card-slap' else 0.24))
+    rat = rattle(2.18, 0.7, 1 + 0.04 * (n - 1), 0.25 + 0.04 * n)
+    S[f'chain-{n}'] = sat(norm(room(mix(x, at(rat, LEAD + 0.03))), 0.93), 1.15)
+t = 0.0; roll = []; gap = 0.15; i = 0
+while gap > 0.035:
+    roll.append(at(hit(STYLE if STYLE != 'card-slap' else 'tsuke', 0.4 + 0.035 * i, 1 + 0.01 * i), t)); t += gap; gap *= 0.84; i += 1
+roll.append(at(hit(STYLE, 1.4, 1.02), t + 0.08 - LEAD))
+if STYLE == 'tsuke': roll.append(at(hit(STYLE, 1.5, 0.98), t + 0.08 + 0.11))
+S['chain-lock'] = sat(norm(room(mix(*[r if len(r) else np.zeros(1) for r in roll], at(rattle(2.18, 0.9, 0.95, 0.35), t + 0.1)), 0.06), 0.93), 1.15)
+S['chain-resolve'] = sat(norm(room(mix(hit(STYLE, 0.6, 0.92), at(rattle(2.25, 0.5, 0.97, 0.25), LEAD + 0.02))), 0.9), 1.1)
+
+manifest = json.load(open(os.path.join(OUT, 'sfx.json'))) if os.path.exists(os.path.join(OUT, 'sfx.json')) else {'sounds': {}}
+for name, x in S.items():
+    x = norm(fade_tail(trim(x)), 0.84)
+    wav = os.path.join(OUT, name + '.wav'); mp3 = os.path.join(OUT, name + '.mp3')
+    wavfile.write(wav, SR, (np.clip(x, -1, 1) * 32767).astype(np.int16))
+    subprocess.run(['ffmpeg', '-v', 'error', '-y', '-i', wav, '-codec:a', 'libmp3lame', '-b:a', '128k', '-map_metadata', '-1', mp3], check=True)
+    os.remove(wav); manifest['sounds'][name] = {'file': name + '.mp3', 'seconds': round(len(x) / SR, 2)}
+manifest['version'] = 'r34.1'
+manifest['note'] = f'Original rendered SFX (tools/r28-render-sfx.py; chain-1..4, chain-lock, chain-resolve re-rendered as {STYLE} by tools/r34-render-wood-sfx.py). Chain rattle layer uses the CC0 BigSoundBank 0359 recording.'
+json.dump(manifest, open(os.path.join(OUT, 'sfx.json'), 'w'), indent=1)
+print(json.dumps({k: manifest['sounds'][k] for k in S}))
