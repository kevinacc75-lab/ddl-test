+// r35.3 HUD fit (Kevy's 24 Oct recordings: the gear covered the opponent's last LP digit on a 16:10 screen).
+// SELF-VERIFIED (builder). jsdom has no layout, so the boxes are stubbed: an overlapping bar is moved left until it
+// clears the gear by 8px; a bar that already clears it is left alone.
+import assert from 'node:assert/strict';import {JSDOM} from 'jsdom';import fs from 'node:fs';
+const dom=new JSDOM('<body class="in-duel"><button class="duel-controls-fab"></button><div id="duel"><div class="player-bar opponent"></div></div></body>');
+globalThis.document=dom.window.document;globalThis.getComputedStyle=e=>({right:e.style.getPropertyValue('right')||'20px'});
+globalThis.addEventListener=()=>{};globalThis.requestAnimationFrame=f=>f();globalThis.cancelAnimationFrame=()=>{};globalThis.setInterval=()=>0;
+const gear=document.querySelector('.duel-controls-fab'),bar=document.querySelector('.player-bar');
+gear.getBoundingClientRect=()=>({left:1085,right:1137,top:16,bottom:64,width:52});
+let base=1127;bar.getBoundingClientRect=()=>{const r=parseFloat(bar.style.getPropertyValue('right')||'20');const right=base-(r-20)*0.7;return {left:right-260,right,top:15,bottom:67,width:260}};/* scaled table: 1 CSS px = 0.7 screen px */
+const {installHudFit}=await import('../dist/hud-fit.mjs');const fit=installHudFit();fit.fit();
+const b=bar.getBoundingClientRect();assert.ok(b.right+8<=1085.5,'bar clears the gear: '+b.right);
+base=990;fit.fit();assert.equal(bar.style.getPropertyValue('right'),'','already clear: no override');
+assert.ok(JSON.parse(fs.readFileSync('dist/offline-assets.json')).includes('./hud-fit.mjs'),'cached offline');
+console.log(JSON.stringify({test:'r35-hud-fit',pass:true,node:process.version,selfVerified:true}));
