+const card=(name,location=2,extra={})=>({code:code(name),controller:0,location,sequence:0,position:location===8?10:0,...extra});
+const view=({top=KITT,topLoc=16,turn=3,oppField=[]}={})=>({active:1,turn,phase:4,order:[1,0],decks:[{id:'blueeyes'},{id:'branded'}],db,name:c=>db[c]?.name||'',
+ chain:top?[{code:top,controller:1,location:topLoc,triggering_location:topLoc,sequence:0}]:[],zone:(s,l)=>s===1&&l===4?oppField.map((n,i)=>({code:code(n),controller:1,location:4,sequence:i,position:1})):s===1&&l===2?[1,2,3,4].map(()=>({code:0})):[],
+ currentEffect:null,attempts:new Map(),hint:0,key:c=>[c.code,c.controller,c.location,c.sequence].join(':')});
+const chainPrompt=names=>({type:M.SELECT_CHAIN,selects:names.map((n,i)=>card(n,n===IMPERM&&i===99?8:2,{sequence:i}))});
+// 1. KT-1 core: Belle is the forced answer on Kitt's GY revive (link in the GY).
+{const r=handTrapUse(view(),0,chainPrompt([ASH,IMPERM,VEILER,BELLE]));assert.ok(r,'a hand trap is used on a key card');assert.equal(r.card,BELLE,'Belle, not Ash (HT_ORDER puts Ash first)')}
+// 2. KT-2 core: with only Ash / Imperm / Veiler offered, nothing is forced on Kitt (link in the GY or the hand).
+for(const loc of [16,2])assert.equal(handTrapUse(view({topLoc:loc}),0,chainPrompt([ASH,IMPERM,VEILER])),null,'no Ash/Imperm/Veiler forced on Kitt (loc '+loc+')');
+// 3. KT-2 core: the activation block refuses all three, from the hand and as a Set Imperm (location 8).
+for(const n of [ASH,IMPERM,VEILER])assert.match(bookActivationBlock(view(),0,card(n))||'',/never .* on Tri-Brigade Springans Kitt/,n+' blocked on Kitt');
+assert.match(bookActivationBlock(view(),0,card(IMPERM,8))||'',/never Infinite Impermanence/,'Set Imperm blocked on Kitt too');
+assert.equal(neverOnBlock(view(),0,card(BELLE)),null,'Belle is not guarded');
+// 4. Scope: the revived Fallen of Albaz's own link (a different code) is not guarded.
+for(const n of [IMPERM,VEILER])assert.equal(neverOnBlock(view({top:code('Fallen of Albaz'),topLoc:4,oppField:['Fallen of Albaz']}),0,card(n)),null,n+' allowed on the revived monster');
+// 5. Our own Kitt link (we are the controller) is not guarded; no chain, no guard.
+{const v=view();v.chain[0].controller=0;assert.equal(neverOnBlock(v,0,card(ASH)),null)}
