+// The native duel fixtures (KT-1..KT-4 with real holders, SDP Q16, Kashtira punish timing Q17) are separate (part B).
+import assert from 'node:assert/strict';import fs from 'node:fs';import {gunzipSync} from 'node:zlib';
+import {M} from '../dist/duel.mjs';import {handTrapUse,bookActivationBlock,neverOnBlock,NEVER_ON} from '../dist/ai/book/book.mjs';
+const db=JSON.parse(gunzipSync(fs.readFileSync('dist/cards.json.gz'))),code=n=>+Object.keys(db).find(k=>db[k].name===n);
+const KITT=19304410,ASH='Ash Blossom & Joyous Spring',BELLE='Ghost Belle & Haunted Mansion',IMPERM='Infinite Impermanence',VEILER='Effect Veiler';
+assert.equal(db[KITT]?.name,'Tri-Brigade Springans Kitt');
