+const PUNISHERS=[F,U,O,PREP,BIRTH];
+// Watch Kashtira's prompts: punishes offered while a hand trap is on the chain, and after the chain is empty.
+function watch(){const w={during:[],after:[]};return {w,onPrompt:d=>{const m=d.prompt;if(seatOf(m)!==0)return false;const top=d.chain?.at?.(-1),offered=new Set();
+  for(const l of labels(d))for(const n of PUNISHERS)if(l==='Chain · '+n)offered.add(n);if(m.type===M.SELECT_EFFECTYN&&PUNISHERS.includes(d.name(m.code||0)))offered.add(d.name(m.code)+' (trigger)');
+  if(top&&d.chain.some(x=>[ASH,IMPERM].includes(d.name(x.code))))w.during.push(...offered);else if(!top)w.after.push(...offered);return false}}}
+const stopAtIdle=d=>seatOf(d.prompt)===0&&d.prompt.type===M.SELECT_IDLECMD;
+const results={};
+// K1
+{const d=scenario(['kashtira','blueeyes'],[...board,{name:BIRTH,location:8,owner:0,sequence:0,position:5},{name:ASH,location:2,owner:1}]);const {w,onPrompt}=watch();
+ const handBefore=hand(d,0).length;let idle=0;
+ const r=drive(d,{steps:{0:['Activate · '+F],1:['@'+F+'>Chain · '+ASH]},onPrompt,until:dd=>stopAtIdle(dd)&&++idle===2});
