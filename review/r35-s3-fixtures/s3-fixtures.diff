+function k3(negate){const d=scenario(['kashtira','blueeyes'],[...board,{name:IMPERM,location:2,owner:1},{name:ASH,location:2,owner:1}]);let idle=0,unicornOffered=false;const ed0=d.zone(1,64).filter(Boolean).length;
+ const s1=negate?['@'+F+'>Chain · '+IMPERM,'Spell / Trap zone 1','pick:'+U,'@'+O+'>Chain · '+ASH]:['@'+O+'>Chain · '+ASH];
+ const r=drive(d,{steps:{0:['Activate · '+F,'pick:Kashtira Riseheart','Activate · '+O,'Chain · '+U],1:s1},
+  onPrompt:dd=>{const m=dd.prompt;if(seatOf(m)===0&&labels(dd).includes('Chain · '+U)&&!dd.chain?.length)unicornOffered=true;
+   if(seatOf(m)===0&&m.type===M.SELECT_CARD&&dd.name(dd.currentEffect?.code||0)===U){dd.respond({type:R.SELECT_CARD,indicies:[0]});return true}return false},
+  until:dd=>stopAtIdle(dd)&&++idle===3});
+ assert.ok(r.stopped&&!r.unused[0].length&&!r.unused[1].length,'K3 ran (negate '+negate+'): '+JSON.stringify(r));
+ const out={negate,unicornOffered,extraDeck:[ed0,d.zone(1,64).filter(Boolean).length],banished:d.zone(1,32).filter(Boolean).length};d.stop();return out}
+{const neg=k3(true),ctl=k3(false);
+ assert.equal(ctl.extraDeck[1],ctl.extraDeck[0]-1,'K3 control: an un-negated Unicorn punish banishes 1 from our Extra Deck');
+ assert.equal(neg.extraDeck[1],neg.extraDeck[0],'K3: the Imperm-negated Unicorn punishes nothing this turn (RULES-Q-17)');
+ results.K3={negated:neg,control:ctl,divergence:neg.unicornOffered?'engine offers the negated Unicorn\'s punish (it resolves with no effect)':'not offered'}}
+stopEngine();
+console.log(JSON.stringify({test:'r35-s3-kashtira-native',pass:true,node:process.version,results}));
