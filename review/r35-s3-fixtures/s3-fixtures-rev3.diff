+await engine();
+const SDP='Super Duper Polymerization',LUNA_STEPS=['Activate · '+SDP,'Spell / Trap zone 1','pick:Lunalight Black Sheep','pick:Lunalight Cat Dancer','Monster zone 1','Face-up Attack','Fusion Summon','pick:Lunalight Panther Dancer','Use · Lunalight Cat Dancer','Use · Lunalight Black Sheep','Extra 1','Face-up Attack','No'];
+const base=[{name:SDP,location:2,owner:0},{name:'Lunalight Black Sheep',location:4,owner:0,sequence:2}];
+const results={};
+// Q16-a and Q16-d
