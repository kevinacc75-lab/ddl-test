+// r35 S3 Rev 7 (Akiza review 537f3776, RULES-Q-17; Claude 28 Oct 2026). SELF-VERIFIED (builder = verifier), NOT independent.
+// NATIVE gate fixture for the Kashtira punish timing (Kashtira 19 Oct list vs a Blue-Eyes hand-trap holder).
+// Kashtira (seat 0, going first) controls face-up Kashtira Fenrir, Unicorn and Ogre and activates Fenrir's search.
+//  K1 (Ash): the punishes are NOT chain responses (not offered while Ash is on the chain); after the chain resolves Unicorn
+//      and Ogre are offered; Fenrir is not (we control no face-up card to target); a face-up Kashtira Birth never punishes
+//      a hand trap (Spells only); Ash still resolves (the search is negated).
+//  K2 (Imperm on Fenrir, Preparations face-up): a Trap never triggers Fenrir / Unicorn / Ogre; Preparations' Trap punish
+//      is offered after the chain (face-up Preparations + a face-up Kashtira). K2b: a face-down Preparations does not.
+//  K3 (Imperm on Unicorn, then Ash on Ogre's search): the Imperm-negated Unicorn's punish banishes nothing for the rest of
+//      the turn (control without Imperm: it banishes 1). It may still be activated (rules-correct per Alexis).
+import assert from 'node:assert/strict';
+import {engine,stopEngine,scenario,drive,seatOf,labels,hand,M,R} from '../tools/s3-harness.mjs';
+await engine();
+const F='Kashtira Fenrir',U='Kashtira Unicorn',O='Kashtira Ogre',PREP='Kashtira Preparations',BIRTH='Kashtira Birth',ASH='Ash Blossom & Joyous Spring',IMPERM='Infinite Impermanence';
+const board=[{name:F,location:4,owner:0,sequence:0},{name:U,location:4,owner:0,sequence:1},{name:O,location:4,owner:0,sequence:2}];
+const PUNISHERS=[F,U,O,PREP,BIRTH];
+// Watch Kashtira's prompts: punishes offered while a hand trap is on the chain, and after the chain is empty.
+function watch(){const w={during:[],after:[]};return {w,onPrompt:d=>{const m=d.prompt;if(seatOf(m)!==0)return false;const top=d.chain?.at?.(-1),offered=new Set();
+  for(const l of labels(d))for(const n of PUNISHERS)if(l==='Chain · '+n)offered.add(n);if(m.type===M.SELECT_EFFECTYN&&PUNISHERS.includes(d.name(m.code||0)))offered.add(d.name(m.code)+' (trigger)');
+  if(top&&d.chain.some(x=>[ASH,IMPERM].includes(d.name(x.code))))w.during.push(...offered);else if(!top)w.after.push(...offered);return false}}}
+const stopAtIdle=d=>seatOf(d.prompt)===0&&d.prompt.type===M.SELECT_IDLECMD;
+const results={};
+// K1
+{const d=scenario(['kashtira','blueeyes'],[...board,{name:BIRTH,location:8,owner:0,sequence:0,position:5},{name:ASH,location:2,owner:1}]);const {w,onPrompt}=watch();
+ const handBefore=hand(d,0).length;let idle=0;
+ const r=drive(d,{steps:{0:['Activate · '+F],1:['@'+F+'>Chain · '+ASH]},onPrompt,until:dd=>stopAtIdle(dd)&&++idle===2});
+ assert.ok(r.stopped&&!r.unused[0].length&&!r.unused[1].length,'K1 ran: '+JSON.stringify(r));
+ assert.deepEqual([...new Set(w.during)].filter(n=>[F,U,O].includes(n)),[],'K1: no Fenrir/Unicorn/Ogre punish as a chain response to Ash');
+ const after=new Set(w.after);assert.ok(after.has(U)&&after.has(O),'K1: Unicorn and Ogre punish after the chain resolves: '+[...after]);
+ assert.ok(!after.has(F),'K1: Fenrir cannot punish (we control no face-up card)');assert.ok(![...after].some(n=>n.startsWith(BIRTH)),'K1: Kashtira Birth never punishes a hand trap');
+ assert.equal(hand(d,0).length,handBefore,'K1: Ash resolved first, the search added nothing');
+ results.K1={during:[...new Set(w.during)],after:[...after]};d.stop()}
+// K2 / K2b
+for(const [tag,pos] of [['K2',5],['K2b',10]]){const d=scenario(['kashtira','blueeyes'],[...board,{name:PREP,location:8,owner:0,sequence:1,position:pos},{name:IMPERM,location:2,owner:1}]);const {w,onPrompt}=watch();let idle=0;
+ const r=drive(d,{steps:{0:['Activate · '+F],1:['@'+F+'>Chain · '+IMPERM,'Spell / Trap zone 1','pick:'+F]},onPrompt,until:dd=>stopAtIdle(dd)&&++idle===2});
+ assert.ok(r.stopped&&!r.unused[0].length&&!r.unused[1].length,tag+' ran: '+JSON.stringify(r));
+ const after=new Set(w.after);assert.ok(![F,U,O].some(n=>after.has(n)),tag+': a Trap (Imperm) triggers no Fenrir/Unicorn/Ogre punish: '+[...after]);
+ if(tag==='K2')assert.ok(after.has(PREP+' (trigger)'),'K2: face-up Preparations punishes the Trap after the chain: '+[...after]);
+ else assert.ok(!after.has(PREP+' (trigger)'),'K2b: a face-down Preparations does not punish');
+ results[tag]={during:[...new Set(w.during)],after:[...after]};d.stop()}
+// K3 (outcome): the Imperm-negated Unicorn's punish banishes nothing; without Imperm (control) it banishes 1 from our
+// Extra Deck. Rules-correct observation (Alexis, Seto 28 Oct 08:10): a monster negated by Imperm/Veiler CAN still activate
+// its effects; they form a chain link, spend the once per turn and resolve with no effect. The engine offering the negated
+// Unicorn's punish is therefore correct, not an engine bug. (Whether the AI should ever waste such an activation is a
+// separate strategy question for Akiza.)
+function k3(negate){const d=scenario(['kashtira','blueeyes'],[...board,{name:IMPERM,location:2,owner:1},{name:ASH,location:2,owner:1}]);let idle=0,unicornOffered=false;const ed0=d.zone(1,64).filter(Boolean).length;
+ const s1=negate?['@'+F+'>Chain · '+IMPERM,'Spell / Trap zone 1','pick:'+U,'@'+O+'>Chain · '+ASH]:['@'+O+'>Chain · '+ASH];
+ const r=drive(d,{steps:{0:['Activate · '+F,'pick:Kashtira Riseheart','Activate · '+O,'Chain · '+U],1:s1},
+  onPrompt:dd=>{const m=dd.prompt;if(seatOf(m)===0&&labels(dd).includes('Chain · '+U)&&!dd.chain?.length)unicornOffered=true;
+   if(seatOf(m)===0&&m.type===M.SELECT_CARD&&dd.name(dd.currentEffect?.code||0)===U){dd.respond({type:R.SELECT_CARD,indicies:[0]});return true}return false},
+  until:dd=>stopAtIdle(dd)&&++idle===3});
+ assert.ok(r.stopped&&!r.unused[0].length&&!r.unused[1].length,'K3 ran (negate '+negate+'): '+JSON.stringify(r));
+ const out={negate,unicornOffered,extraDeck:[ed0,d.zone(1,64).filter(Boolean).length],banished:d.zone(1,32).filter(Boolean).length};d.stop();return out}
+{const neg=k3(true),ctl=k3(false);
+ assert.equal(ctl.extraDeck[1],ctl.extraDeck[0]-1,'K3 control: an un-negated Unicorn punish banishes 1 from our Extra Deck');
+ assert.equal(neg.extraDeck[1],neg.extraDeck[0],'K3: the Imperm-negated Unicorn punishes nothing this turn (RULES-Q-17)');
+ results.K3={negated:neg,control:ctl,observation:neg.unicornOffered?'negated Unicorn\'s punish is offered and resolves with no effect (rules-correct, Alexis 28 Oct)':'not offered'}}
+stopEngine();
+console.log(JSON.stringify({test:'r35-s3-kashtira-native',pass:true,node:process.version,results}));
