+++ b/tests/r35-ohime-revive.test.mjs
@@ -0,0 +1,23 @@
+// r35 queue item 5 (Claude, 28 Oct 2026). SELF-VERIFIED (builder = verifier), NOT independent. NATIVE engine fixture.
+// Question (Claude's 24 Oct list): can Mikanko Fire Dance revive an Ohime the Manifested Mikanko that was never properly
+// summoned? Ohime has a revive limit (script: EnableReviveLimit); Fire Dance summons with IsCanBeSpecialSummoned(e,0,tp,
+// false,false), i.e. it does NOT ignore the revive limit.
+//  A: Ohime sent to the GY without being properly summoned (dealt to the GY), with Sanaki (no revive limit) also in the GY:
+//     Fire Dance offers Sanaki and NOT Ohime (nor an Ohime in the hand). The engine enforces the revive limit.
+//  Noble Twins case: ANSWERED by Alexis (Konami OCG Q&A #23954, names Noble Twins; Seto 28 Oct 08:10): a Ritual Monster
+//     Special Summoned by Noble Twins' GY effect is NOT properly summoned, so Fire Dance can never revive it (nor Promise,
+//     Water Arabesque, Spiritwalk, Mayowashidori; The Great Mikanko Ceremony ignores conditions and can). No played-line
+//     fixture is built (Seto). The engine already refuses Ohime's revive without proc-complete status (case A).
+import assert from 'node:assert/strict';
+import {engine,stopEngine,scenario,drive,seatOf,M} from '../tools/s3-harness.mjs';
+await engine();
+const OHIME='Ohime the Manifested Mikanko',SANAKI='Sanaki the Mikanko Devotee',FD='Mikanko Fire Dance';
+const d=scenario(['mikanko','blueeyes'],[{name:FD,location:2,owner:0},{name:OHIME,location:16,owner:0},{name:SANAKI,location:16,owner:0}]);
+const ohimeGy=d.zone(0,16).find(c=>c&&d.name(c.code)===OHIME);assert.ok(ohimeGy,'Ohime is in the GY');assert.equal(ohimeGy.status&8,0,'Ohime in the GY was never properly summoned (no proc-complete status)');
+let offered=null;
+const r=drive(d,{steps:{0:['Activate · '+FD,'Spell / Trap zone 1']},until:dd=>{const m=dd.prompt;if(seatOf(m)===0&&m.type===M.SELECT_CARD&&dd.name(dd.currentEffect?.code||0)===FD){offered=(m.selects||[]).map(c=>({name:dd.name(c.code),location:c.location}));return true}return false}});
+assert.ok(r.stopped&&offered,'reached Fire Dance\'s summon choice: '+JSON.stringify(r));
+assert.ok(offered.some(c=>c.name===SANAKI&&c.location===16),'A: Fire Dance offers Sanaki from the GY (control)');
+assert.ok(!offered.some(c=>c.name===OHIME),'A: Fire Dance does not offer an Ohime that was never properly summoned (GY or hand)');
+d.stop();stopEngine();
+console.log(JSON.stringify({test:'r35-ohime-revive',pass:true,node:process.version,offered}));
